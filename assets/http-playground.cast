[4659.010811, "o", "\u001b[2;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[3;8H                                                      \u001b[14;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[15;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[16;36Hon Control Protocol (TCP)                          \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[17;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[18;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[19;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[20;36Hhe Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[21;36H-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[22;36Hously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[23;36His time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[3;62H\u001b[38;2;156;207;216m╭──