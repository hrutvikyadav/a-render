[4607.548396, "o", "\u001b[?2026h\u001b[H\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  8 \u001b[38;2;224;222;244m“where do these tcpdump fields come from, and how do I interpret them?”.       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;196;167;231m\r\n   6 \u001b[38;2;224;222;244mHere’s a \u001b[58:2::196:167:231m\u001b[4:3mroadmap\u001b(B\u001b[m\u001b[38;2;224;222;244m for you:                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  4 \u001b[38;2;49;116;143m1. \u001b[38;2;224;222;244mThe Source: \u001b[48;2;50;54;63mRFC\u001b[49ms                                                            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  2 \u001b[38;2;224;222;244mIP layer (IPv4): \u001b[48;2;50;54;63mRFC\u001b[49m 791 \u001b[38;2;156;207;216m/RFC        [2/8]\u001b[38;2;224;222;244m                                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  1 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[1m9   \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mDefines fields like tos, ttl, offset, id, flags, etc.                          \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                     \u001b[49m\u001b[11;1H  \u001b[38;2;110;106;134m  1 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  2 \u001b[38;2;224;222;244mTCP layer: \u001b[48;2;50;54;63mRFC\u001b[49m 9293                                                            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244m (current TCP standard, obsoletes \u001b[48;2;50;54;63mRFC\u001b[49m 793)                                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  4 \u001b[38;2;224;222;244mDefines seq (sequence number), ack, flags (SYN/ACK/FIN/PSH/RST), window size, o\u001b[48;2;31;29;46mp\u001b[49mtions (MSS, SACK, timestamps, etc.).\u001b[39m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  6 \u001b[38;2;224;222;244mHTTP layer: \u001b[48;2;50;54;63mRFC\u001b[49m 9112                                                           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244m (you already have this!)                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  8 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  9 \u001b[38;2;224;222;244mThe \u001b[48;2;50;54;63mRFC\u001b[49ms are “ground truth.” Tcpdump’s lingo comes straight from those header f\u001b[48;2;31;29;46mi\u001b[49melds.\u001b[39m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 10 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 11 \u001b[38;2;49;116;143m2. \u001b[38;2;224;222;244mPractical Field-by-Field Guides                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 12 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;"]
[4607.548575, "o", "134m 13 \u001b[38;2;224;222;244mIf \u001b[48;2;50;54;63mRFC\u001b[49ms feel too dense, these are great cheat sheets:                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 15 \u001b[38;2;224;222;244mIP header field explanations:                                                  \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 16 \u001b[38;2;224;222;244mIP Header Fields Explained (PacketLife)                                        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 18 \u001b[38;2;224;222;244mTCP header fields:                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 19 \u001b[38;2;224;222;244mTCP Header Fields Explained (PacketLife)                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 20 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 21 \u001b[38;2;224;222;244mEach shows you a diagram of the packet header and what fields like ttl, seq, wi\u001b[48;2;31;29;46mn\u001b[49m, mss mean.\u001b[39m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 22 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 23 \u001b[38;2;49;116;143m3. \u001b[38;2;224;222;244mBooks                                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 24 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m 25 \u001b[38;2;224;222;244mComputer Networking: A Top-Down Approach (Kurose & Ross) → good for learning co\u001b[48;2;31;29;46mn\u001b[49mcepts like TTL and sequence numbers in context.\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[A\u001b[?2026l"]
