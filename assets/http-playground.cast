[4778.351036, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                        |   Local Network Protocol  |                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16 \u001b[38;2;224;222;244m \u001b[4;5H\u001b[38;2;110;106;134m15 \u001b[38;2;224;222;244m \u001b[5;5H\u001b[38;2;110;106;134m14 \u001b[38;2;224;222;244m \u001b[6;5H\u001b[38;2;110;106;134m13 \u001b[38;2;224;222;244m \u001b[7;5H\u001b[38;2;110;106;134m12 \u001b[38;2;224;222;244m \u001b[8;5H\u001b[38;2;110;106;134m11 \u001b[38;2;224;222;244m \u001b[9;5H\u001b[38;2;110;106;134m10 \u001b[38;2;224;222;244m \u001b[10;6H\u001b[38;2;110;106;134m9 \u001b[38;2;224;222;244m \u001b[11;6H\u001b[38;2;110;106;134m8 \u001b[38;2;224;222;244m \u001b[12;5H\u001b[38;2;110;106;134m 7 \u001b[38;2;224;222;244m \u001b[13;5H\u001b[38;2;110;106;134m 6 \u001b[38;2;224;222;244m \u001b[14;5H\u001b[38;2;110;106;134m 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m513  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m                                                                               \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m    We suppose that this transmission will involve one intermediate            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m    gateway.                                                                   \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m    The sending application program prepares its data and calls on its         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m    local internet module to send that data as a datagram and passes the       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m    destination address and other parameters as arguments of the call.         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m    The internet module prepares a datagram header and attaches the data       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m    to it.  The internet module determines a local network address for         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m    this internet address, in this case it is the address of a gateway.        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                                                               \u001b[1;38r\u001b[31;87H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4778.352765, "o", "\u001b[38;2;224;222;244m\u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m                                                                [Page 5]       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;156;207;216m^L\u001b[38;2;224;222;244m                                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m                                                          September 1981       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244mInternet Protocol                                                              \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;145H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m513,0-1                        94892 B  17\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
