[4771.720219, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16 \u001b[38;2;224;222;244m \u001b[4;5H\u001b[38;2;110;106;134m15 \u001b[38;2;224;222;244m \u001b[5;5H\u001b[38;2;110;106;134m14 \u001b[38;2;224;222;244m \u001b[6;5H\u001b[38;2;110;106;134m13 \u001b[38;2;224;222;244m \u001b[7;5H\u001b[38;2;110;106;134m12 \u001b[38;2;224;222;244m \u001b[8;5H\u001b[38;2;110;106;134m11 \u001b[38;2;224;222;244m \u001b[9;5H\u001b[38;2;110;106;134m10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m241  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m                                                                               \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m                           INTERNET PROTOCOL                                   \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m                         DARPA INTERNET PROGRAM                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m                         PROTOCOL SPECIFICATION                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m                            1.  INTRODUCTION                                   \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m1.1.  Motivation                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m  The Internet Protocol is designed for use in interconnected systems of       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m  packet-switched computer communication networks.  Such a system has          \u001b[48;2;31;29;46m \u001b[1;38r\u001b[32;88H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4771.7221, "o", "\u001b[?2026h\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m  been called a \"catenet\" [1].  The internet protocol provides for             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[38;2;224;222;244m  transmitting blocks of data called datagrams from sources to                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m  destinations, where sources and destinations are hosts identified by         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  fixed length addresses.  The internet protocol also provides for             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m41\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4771.887592, "o", "\u001b[?2026h\u001b[?25l\u001b[2 q\u001b[?25l\u001b[35m\u001b[38;1H[\"protocols\"] \u001b[36m172.20.217.19 | \u001b[31m 50 | \u001b[38;2;204;204;204m \u001b[39m |                                                     \u001b[32m0:nvim*\u001b[39m                                                   \u001b[33m 0.56, 0.32, 0.31 | \u001b[34m\u001b[3m\u001b[4m12:41 03-Sep-25\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[19;8H\u001b[2 q\u001b[?12l\u001b[?25h\u001b[?2026l"]
[4772.119714, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m258  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  fixed length addresses.  The internet protocol also provides for             \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m  fragmentation and reassembly of long datagrams, if necessary, for            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m  transmission through \"small packet\" networks.                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m1.2.  Scope                                                                    \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m  The internet protocol is specifically limited in scope to provide the        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m  functions necessary to deliver a package of bits (an internet                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m  datagram) from a source to a destination over an interconnected system       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  of networks.  There are no mechanisms to augment end-to-end data             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  reliability, flow control, sequencing, or other services commonly            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m  found in host-to-host protocols.  The internet protocol can capitalize       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m  on the services of its supporting networks to provide various types          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m  and qualities of service.                                                    \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4772.121074, "o", "\u001b[38;2;224;222;244m1.3.  Interfaces                                                               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  This protocol is called on by host-to-host protocols in an internet          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m58,1                          94892 B   8\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4772.296793, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  fixed length addresses.  The internet protocol also provides for             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m275  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  This protocol is called on by host-to-host protocols in an internet          \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m  environment.  This protocol calls on local network protocols to carry        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m  the internet datagram to the next gateway or destination host.               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m  For example, a TCP module would call on the internet module to take a        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m  TCP segment (including the TCP header and user data) as the data             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m  portion of an internet datagram.  The TCP module would provide the           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m  addresses and other parameters in the internet header to the internet        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m  module as arguments of the call.  The internet module would then             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  create an internet datagram and call on the local network interface to       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  transmit the internet datagram.                                              \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m  In the ARPANET case, for example, the internet module would call on a        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4772.298092, "o", "\u001b[38;2;224;222;244m                                                                [Page 1]       \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;156;207;216m^L\u001b[38;2;224;222;244m                                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m75,1                          94892 B   9\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4772.47916, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  This protocol is called on by host-to-host protocols in an internet          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m292  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m                                                                               \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m                                                          September 1981       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244mInternet Protocol                                                              \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244mIntroduction                                                                   \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m  local net module which would add the 1822 leader [2] to the internet         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m  datagram creating an ARPANET message to transmit to the IMP.  The            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  ARPANET address would be derived from the internet address by the            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  local network interface and would be the address of some host in the         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m  ARPANET, that host might be a gateway to other networks.                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m1.4.  Operation                                                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4772.481331, "o", "\u001b[38;2;224;222;244m  The internet protocol implements two basic functions:  addressing and        \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m  fragmentation.                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m92,0-1\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4772.632474, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m309  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m                                                                               \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m  The internet modules use the addresses carried in the internet header        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m  to transmit internet datagrams toward their destinations.  The               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m  selection of a path for transmission is called routing.                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m  The internet modules use fields in the internet header to fragment and       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m  reassemble internet datagrams when necessary for transmission through        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m  \"small packet\" networks.                                                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  The model of operation is that an internet module resides in each host       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  engaged in internet communication and in each gateway that                   \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m  interconnects networks.  These modules share common rules for                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m  interpreting address fields and for fragmenting and assembling               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m  internet datagrams.  In addition, these modules (especially in               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m  gateways) have procedures for making routing decisions and other             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4772.633324, "o", "\u001b[38;2;224;222;244m  functions.                                                                   \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  The internet protocol treats each internet datagram as an independent        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;145H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m309,0-1                        94892 B  10\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4772.823174, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m326  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  The internet protocol treats each internet datagram as an independent        \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m  entity unrelated to any other internet datagram.  There are no               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m  connections or logical circuits (virtual or otherwise).                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m  The internet protocol uses four key mechanisms in providing its              \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m  service:  Type of Service, Time to Live, Options, and Header Checksum.       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m  The Type of Service is used to indicate the quality of the service           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m  desired.  The type of service is an abstract or generalized set of           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  parameters which characterize the service choices provided in the            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  networks that make up the internet.  This type of service indication         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m  is to be used by gateways to select the actual transmission parameters       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m  for a particular network, the network to be used for the next hop, or        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m  the next gateway when routing an internet datagram.                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4772.824059, "o", "\u001b[38;2;224;222;244m  The Time to Live is an indication of an upper bound on the lifetime of       \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m  an internet datagram.  It is set by the sender of the datagram and           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  reduced at the points along the route where it is processed.  If the         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m26,1  \u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4773.045923, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  The internet protocol treats each internet datagram as an independent        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m343  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  reduced at the points along the route where it is processed.  If the         \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m  time to live reaches zero before the internet datagram reaches its           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m  destination, the internet datagram is destroyed.  The time to live can       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m  be thought of as a self destruct time limit.                                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m[Page 2]                                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;156;207;216m^L\u001b[38;2;224;222;244m                                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244mSeptember 1981                                                                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m                                                       Internet Protocol       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m                                                            Introduction       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[1;38r\u001b[34;3H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4773.046864, "o", "\u001b[38;2;110;106;134m  15 \u001b[38;2;224;222;244m  The Options provide for control functions needed or useful in some           \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m  situations but unnecessary for the most common communications.  The          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  options include provisions for timestamps, security, and special             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m43,1                          94892 B  11\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
[4773.280397, "o", "\u001b[?2026h\u001b[2;36r\u001b[2;1H\u001b[17M\u001b[2;3H\u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m  reduced at the points along the route where it is processed.  If the         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m16\u001b[4;5H15\u001b[5;5H14\u001b[6;5H13\u001b[7;5H12\u001b[8;5H11\u001b[9;5H10\u001b[10;6H9\u001b[11;6H8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[15;5H 4\u001b[16;5H 3\u001b[17;5H 2\u001b[18;5H 1\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m360  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  options include provisions for timestamps, security, and special             \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m  routing.                                                                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m  The Header Checksum provides a verification that the information used        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m  in processing internet datagram has been transmitted correctly.  The         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m  data may contain errors.  If the header checksum fails, the internet         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m  datagram is discarded at once by the entity which detects the error.         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m  The internet protocol does not provide a reliable communication              \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  facility.  There are no acknowledgments either end-to-end or                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  hop-by-hop.  There is no error control for data, only a header               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m  checksum.  There are no retransmissions.  There is no flow control.          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m  Errors detected may be reported via the Internet Control Message             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m  Protocol (ICMP) [3] which is implemented in the internet protocol            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
