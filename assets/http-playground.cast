[4829.636974, "o", "\u001b[?2026h\u001b[38;2;144;140;170m\u001b[Hrfc791.txt                                                                                                                                                                                 \u001b[38;2;224;222;244m\u001b[2;1H  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m        Precedence                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  15 \u001b[38;2;224;222;244m          111 - Network Control                                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m          110 - Internetwork Control                                           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m          101 - CRITIC/ECP                                                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m          100 - Flash Override                                                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m          011 - Flash                                                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m          010 - Immediate                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m          001 - Priority                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m          000 - Routine                                                        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m    The use of the Delay, Throughput, and Reliability indications may          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m    increase the cost (in some sense) of the service.  In many networks        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m    better performance for one of these parameters is coupled with worse       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m    performance on another.  Except for very unusual cases at most two         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m    of these three indications should be set.                                  \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[1m931  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m    The \u001b[38;2;25;23;36m\u001b[48;2;149;177;172mtype of serv\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mice is used to specify the treatment of the datagram       \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[49m\u001b[20;1H  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m    during its transmission through the internet system.  Example              \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m    mappings of the internet \u001b[48;2;50;54;63mtype of serv\u001b[49mice to the actual service             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m    provided on networks such as AUTODIN II, ARPANET, SATNET, and PRNET        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;"]
[4829.637341, "o", "224;222;244m\r\n  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m    is given in \"Service Mappings\" [8].                                        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m[Page 12]                                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m   9 \u001b[38;2;156;207;216m^L\u001b[38;2;224;222;244m                                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244mSeptember 1981                                                                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                                       Internet Protocol       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m                                                           Specification       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  15 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;224;222;244m\r\n  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m    The Network Control precedence designation is intended to be used          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[38;2;246;193;119m\r\n \u001b[38;2;224;222;244m type of serv\u001b[38;2;110;106;134mice\u001b[38;2;224;222;244m                                                                                                                                                                        \u001b[2 q\u001b[?25l\u001b[35m\u001b[38;1H[\"protocols\"] \u001b[36m172.20.217.19 | \u001b[31m 50 | \u001b[38;2;204;204;204m \u001b[39m |                                                     \u001b[32m0:nvim*\u001b[39m                                                   \u001b[33m 0.34, 0.29, 0.30 | \u001b[34m\u001b[3m\u001b[4m12:42 03-Sep-25\u001b(B\u001b[m\u001b[37;17H\u001b[2 q\u001b[?12l\u001b[?25h\u001b[?2026l"]
