[4173.721884, "o", "\r\u001b[38;2;224;222;244m  \u001b[1m1   \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m“where do these tcpdump fields come from, and how do I interpret them?”.       \u001b[48;2;31;29;46m \r\n\u001b[49m  \u001b[38;2;110;106;134m  1 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \r\n\u001b[49m  \u001b[38;2;110;106;134m  2 \u001b[38;2;224;222;244mHere’s a roadmap for you:                                                      \u001b[48;2;31;29;46m \r\n\u001b[49m  \u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  4 \u001b[38;2;49;116;143m1. \u001b[38;2;224;222;244mThe Source: RFCs                                                            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  6 \u001b[38;2;224;222;244mIP layer (IPv4): RFC 791                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  8 \u001b[38;2;224;222;244mDefines fields like tos, ttl, offset, id, flags, etc.                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  9 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 10 \u001b[38;2;224;222;244mTCP layer: RFC 9293                                                            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 11 \u001b[38;2;224;222;244m (current TCP standard, obsoletes RFC 793)                                     \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 12 \u001b[38;2;224;222;244mDefines seq (sequence number), ack, flags (SYN/ACK/FIN/PSH/RST), window size, o\u001b[48;2;31;29;46mp\u001b[49mtions (MSS, SACK, timestamps, etc.).\u001b[39m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 13 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 14 \u001b[38;2;224;222;244mHTTP layer: RFC 9112                                                           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 15 \u001b[38;2;224;222;244m (you already have this!)                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 16 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 17 \u001b[38;2;224;222;244mThe RFCs are “ground truth\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4173.723262, "o", "\u001b[38;2;224;222;244m.” Tcpdump’s lingo comes straight from those header f\u001b[48;2;31;29;46mi\u001b[49melds.\u001b[?2026h\u001b[39m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 18 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 19 \u001b[38;2;49;116;143m2. \u001b[38;2;224;222;244mPractical Field-by-Field Guides                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 20 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 21 \u001b[38;2;224;222;244mIf RFCs feel too dense, these are great cheat sheets:                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 22 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 23 \u001b[38;2;224;222;244mIP header field explanations:                                                  \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 24 \u001b[38;2;224;222;244mIP Header Fields Explained (PacketLife)                                        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 25 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 26 \u001b[38;2;224;222;244mTCP header fields:                                                             \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 27 \u001b[38;2;224;222;244mTCP Header Fields Explained (PacketLife)                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 28 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 29 \u001b[38;2;224;222;244mEach shows you a diagram of the packet header and what fields like ttl, seq, wi\u001b[48;2;31;29;46mn\u001b[49m, mss mean.\u001b[39m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 30 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 31 \u001b[38;2;49;116;143m3. \u001b[38;2;224;222;244mBooks                                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 32 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 33 \u001b[38;2;224;222;244mComputer Networking: A Top-Down Approach (Kurose & Ross) → good for learning co\u001b[48;2;31;29;46mn\u001b[49mcepts like TTL and sequence numbers in context.\u001b[39m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 34 \u001b[38;2;224;222;244m                                    \u001b(B\u001b[m\u001b[?2026l"]
