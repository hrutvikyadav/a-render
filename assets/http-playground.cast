ent specifies the Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  19 \u001b[38;2;224;222;244m   is an important transport-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  20 \u001b[38;2;224;222;244m   stack, and it has continuously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  21 \u001b[38;2;224;222;244m   of the Internet.  Over this time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  22 \u001b[38;2;224;222;244m   to TCP as it was specified in \u001b[48;2;50;54;63mRFC\u001b[49m 793, though these have only been          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  23 \u001b[38;2;224;222;244m   documented in a piecemeal fashion.  This document collects and brings       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  24 \u001b[38;2;224;222;244m   those changes together with the protocol specification from \u001b[48;2;50;54;63mRFC\u001b[49m 793.        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  25 \u001b[38;2;224;222;244m   This document obsoletes \u001b[48;2;50;54;63mRFC\u001b[49m 793, as well as \u001b[48;2;50;54;63mRFC\u001b[49ms 879, 2873, 6093,           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  26 \u001b[38;2;224;222;244m   6429, 6528, and 6691 that updated parts of \u001b[48;2;50;54;63mRFC\u001b[49m 793.  It updates \u001b[48;2;50;54;63mRFC\u001b[49ms        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  27 \u001b[38;2;224;222;244m   1011 and 1122, and it should be considered as a replacement for the         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  28 \u001b[38;2;224;222;244m   portions of those documents dealing with TCP requirements.  It also         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  29 \u001b[38;2;224;222;244m   updates \u001b[48;2;50;54;63mRFC\u001b[49m 5961 by adding a small clarification in reset handling          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  30 \u001b[38;2;224;222;244m   while in the SYN-RECEIVED state.  The TCP header control bits from          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  31 \u001b[38;2;224;222;244m   \u001b[48;2;50;54;63mRFC\u001b[49m 793 have also been updated based on \u001b[48;2;50;54;63mRFC\u001b[49m 3168.                           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  32 \u001b[38;2;224;222;244m                                                      \u001b(B\u001b[m\u001b[?2026l"]
