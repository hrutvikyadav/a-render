[4660.322329, "o", "\u001b[2;3H\u001b[38;2;224;222;244m\u001b[1m1   \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m“where do these tcpdump fields come from, and how do I interpret them?”.       \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                     \u001b[3;5H\u001b[49m\u001b[38;2;110;106;134m1 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[4;5H\u001b[38;2;110;106;134m2 \u001b[38;2;224;222;244mHere’s a roadmap for you:                                                      \u001b[48;2;31;29;46m \u001b[49m \u001b[5;5H\u001b[38;2;110;106;134m3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[6;5H\u001b[38;2;110;106;134m4 \u001b[38;2;49;116;143m1. \u001b[38;2;224;222;244mThe Source: RFCs                                                            \u001b[48;2;31;29;46m \u001b[49m \u001b[7;5H\u001b[38;2;110;106;134m5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[8;5H\u001b[38;2;110;106;134m6 \u001b[38;2;224;222;244mIP layer (IPv4): RFC 791                                                       \u001b[48;2;31;29;46m \u001b[49m \u001b[9;3H\u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\u001b[10;5H\u001b[38;2;110;106;134m8 \u001b[38;2;224;222;244mDefines fields like tos, ttl, offset, id, flags, etc.                          \u001b[48;2;31;29;46m \u001b[49m \u001b[11;5H\u001b[38;2;110;106;134m9 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[12;4H\u001b[38;2;110;106;134m10 \u001b[38;2;224;222;244mTCP layer: RFC 9293                                                            \u001b[48;2;31;29;46m \u001b[49m \u001b[13;4H\u001b[38;2;110;106;134m11 \u001b[38;2;224;222;244m (current TCP standard, obsoletes RFC 793)                                     \u001b[48;2;31;29;46m \u001b[49m \u001b[14;4H\u001b[38;2;110;106;134m12 \u001b[38;2;224;222;244mDefines seq (sequence number), ack, flags (\u001b[48;2;50;54;63mSYN\u001b[49m/ACK/FIN/PSH/RST), window size, o\u001b[48;2;31;29;46mp\u001b[49mtions (MSS, SACK, timestamps, etc.).\u001b[15;4H\u001b[38;2;110;106;134m13 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[16;4H\u001b[38;2;110;106;134m14 \u001b[38;2;224;222;244mHTTP layer: RFC 9112                                                           \u001b[48;2;31;29;46m \u001b[49m \u001b[17;4H\u001b[38;2;110;106;134m15 \u001b[38;2;224;222;244m (you already have this!)                                                      \u001b[48;2;31;29;46m \u001b[49m \u001b[18;4H\u001b[38;2;110;106;134m16 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[19;4H\u001b[38;2;110;106;134m17 \u001b[38;2;224;222;244mThe RFCs are “ground truth.” Tcpdump’s lingo comes straight from those header f\u001b[48;2;31;29;46mi\u001b[49melds.\u001b[20;4H\u001b[38;2;110;106;134m18 \u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4660.322598, "o", "\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[21;4H\u001b[38;2;110;106;134m19 \u001b[38;2;49;116;143m2. \u001b[38;2;224;222;244mPractical Field-by-Field Guides                                             \u001b[48;2;31;29;46m \u001b[49m \u001b[22;4H\u001b[38;2;110;106;134m20 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[23;4H\u001b[38;2;110;106;134m21 \u001b[38;2;224;222;244mIf RFCs feel too dense, these are great cheat sheets:                          \u001b[48;2;31;29;46m \u001b[49m \u001b[24;4H\u001b[38;2;110;106;134m22 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[25;4H\u001b[38;2;110;106;134m23 \u001b[38;2;224;222;244mIP header field explanations:                                                  \u001b[48;2;31;29;46m \u001b[49m \u001b[26;4H\u001b[38;2;110;106;134m24 \u001b[38;2;224;222;244mIP Header Fields Explained (PacketLife)                                        \u001b[48;2;31;29;46m \u001b[49m \u001b[27;4H\u001b[38;2;110;106;134m25 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[28;4H\u001b[38;2;110;106;134m26 \u001b[38;2;224;222;244mTCP header fields:                                                             \u001b[48;2;31;29;46m \u001b[49m \u001b[29;4H\u001b[38;2;110;106;134m27 \u001b[38;2;224;222;244mTCP Header Fields Explained (PacketLife)                                       \u001b[48;2;31;29;46m \u001b[49m \u001b[30;4H\u001b[38;2;110;106;134m28 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[31;4H\u001b[38;2;110;106;134m29 \u001b[38;2;224;222;244mEach shows you a diagram of the packet header and what fields like ttl, seq, wi\u001b[48;2;31;29;46mn\u001b[49m, mss mean.\u001b[32;4H\u001b[38;2;110;106;134m30 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[33;4H\u001b[38;2;110;106;134m31 \u001b[38;2;49;116;143m3. \u001b[38;2;224;222;244mBooks                                                                       \u001b[48;2;31;29;46m \u001b[49m \u001b[34;4H\u001b[38;2;110;106;134m32 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[35;4H\u001b[38;2;110;106;134m33 \u001b[38;2;224;222;244mComputer Networking: A Top-Down Approach (Kurose & Ross) →\u001b[H\u001b[38;2;144;140;170mINFO.md    \u001b[35;65H\u001b[38;2;224;222;244m good for learning co\u001b[48;2;31;29;46mn\u001b[49mcepts like TTL and sequence numbers in context.\u001b[36;4H\u001b[38;2;110;106;134m34 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[37;124H\u001b[48;2;46;40;51m  \u001b[38;2;156;207;216m  <20>\u001b[38;2;224;222;244m 󰦕   No KB     1,1                          1494\u001b[2;7H\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
