[4794.614484, "o", "\u001b[2;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   determines a local net address for the destination host.  It calls\u001b[3;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   on the local network interface for that network to send the\u001b[4;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   datagram.                  \u001b[5;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                   \u001b[6;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   This local network interface creates a local network header and\u001b[7;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   attaches the datagram sending the result to the destination host.\u001b[8;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                    \u001b[9;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   At this destination host the datagram is stripped of the local net\u001b[10;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   header by the local network interface and handed to the internet\u001b[11;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   module.            \u001b[12;8H\u001b[38;2;110;106;134m│\u001b[13;8H│\u001b[38;2;224;222;244m   The internet module determines that the datagram is for an       \u001b[14;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   application program in this host.  It passes the data to the       \u001b[15;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   application program in response to a system call, passing the sourc\u001b[16;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   address and other parameters as results of the call.              \u001b[17;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                            \u001b[18;8H\u001b[38;2;110;106;134m│\u001b[19;3H\u001b[38;2;224;222;244m\u001b[1m564  \u001b(B\u001b[m\u001b[38;2;110;106;134m\u001b[48;2;38;35;58m│\u001b[38;2;224;222;244m  Application                                           Application    \u001b[20;8H\u001b[49m\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m  Program                                                   Program\u001b[21;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m        \\                                                   /    \u001b[22;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m      Internet Module      Internet Module      Internet Module       \u001b[23;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m            \\                 /       \\                /\u001b[24;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m            LNI-1          LNI-1      LNI-2         LNI-2\u001b[25;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m               \\           /             \\          /\u001b[26;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m              Local Network 1           Local Network 2\u001b[27;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m        \u001b[28;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m \u001b[29;8H\u001b[38;2;110;106;134m│\u001b[30;8H│\u001b[38;2;224;222;244m                           Transmission Path\u001b[31;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                                                       \u001b[32;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                               Figure 2                                \u001b[33;8H\u001b[38;2;110;106;134m│\u001b[34;8H│\u001b[35;8H│\u001b[36;8H│\u001b[38;2;224;222;244m                                                                    \u001b[37;5Htype of serve\u001b[38;2;110;106;134mce\u001b[124C\u001b[38;2;224;222;244m                                           \u001b[18G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4794.619954, "o", "\u001b[5G\u001b[38;2;224;222;244mtype of serve\u001b[38;2;110;106;134mce\b\b\u001b[?25l\u001b(B\u001b[m"]
[4794.621647, "o", "\u001b[5G\u001b[38;2;224;222;244mtype of serve\u001b[38;2;110;106;134mce\b\b\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4795.584642, "o", "\u001b[5G\u001b[38;2;224;222;244mtype of serv\u001b[38;2;110;106;134mice\u001b[3D\u001b[?25l\u001b(B\u001b[m"]
[4795.585742, "o", "\u001b[2;8H\u001b[38;2;224;222;244m        Precedence                                                    \u001b[3;8H                                                               \u001b[4;8H          111 - Network Control\u001b[5;8H          110 - Internetwork Control\u001b[6;8H          101 - CRITIC/ECP                                         \u001b[7;8H          100 - Flash Override                                       \u001b[8;8H          011 - Flash\u001b[9;8H          010 - Immediate                                             \u001b[10;8H          001 - Priority                                            \u001b[11;8H          000 - Routine\u001b[12;8H \u001b[13;8H    The use of the Delay, Throughput, and Reliability indications may\u001b[14;8H    increase the cost (in some sense) of the service.  In many networks\u001b[15;8H    better performance for one of these parameters is coupled with wors\u001b[16;8H    performance on another.  Except for very unusual cases at most two\u001b[17;8H    of these three indications should be set.\u001b[18;8H \u001b[19;3H\u001b[1m931  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m    The \u001b[38;2;25;23;36m\u001b[48;2;149;177;172mtype of serv\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mice is used to specify the treatment of the datagram\u001b[20;8H\u001b[49m    during its transmission through the internet system.  Example   \u001b[21;8H    mappings of the internet \u001b[48;2;50;54;63mtype of serv\u001b[49mice to the actual service\u001b[22;8H    provided on networks such as AUTODIN II, ARPANET, SATNET, and PRNET\u001b[23;8H    is given in \"Service Mappings\" [8].                  \u001b[24;8H                                                          \u001b[25;8H                                                      \u001b[26;8H                                                        \u001b[27;8H[Page 12]\u001b[28;8H\u001b[38;2;156;207;216m^L\u001b[29;8H\u001b[38;2;224;222;244m \u001b[30;8HSeptember 1981                               \u001b[31;8H                                                       Internet Protocol\u001b[32;8H                                                           Specification\u001b[33;8H \u001b[34;8H \u001b[35;8H \u001b[36;8H    The Network Control precedence designation is intended to be used\u001b[37;5Htype of serv\u001b[38;2;110;106;134mice\u001b[124C\u001b[38;2;224;222;244m                                           \u001b[17G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4795.587916, "o", "\u001b[19;16H\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mtype of serv\u001b[21;37H\u001b[49mtype of serv\u001b[37;5Htype of serv\u001b[38;2;110;106;134mice\u001b[128C\u001b[38;2;224;222;244m  \u001b[17G\u001b[?25l\u001b(B\u001b[m"]
