[4423.914075, "o", "\u001b[?2026h\u001b[21;38r\u001b[38;1H\n\u001b[A       Here is the opening portion of an rlogin from host \u001b[4mrtsg\u001b(B\u001b[m to host \u001b[4mcsam\u001b(B\u001b[m.\r\n\u001b[7m Manual page tcpdump(8) line 492/904 60% (press h for help or q to quit)\u001b(B\u001b[m\u001b[K\u001b[1;38r\u001b[38;73H\u001b[?2026l"]
[4423.947679, "o", "\u001b[?2026h\u001b[21;38r\u001b[38;1H\n\u001b[A              IP rtsg.1023 > csam.login: Flags [S], seq 768512:768512, win 4096, opts [mss 1024]\u001b[K\r\n\u001b[7m Manual page tcpdump(8) line 493/904 60% (press h for help or q to quit)\u001b(B\u001b[m\u001b[K\u001b[1;38r\u001b[38;73H\u001b[?2026l"]
