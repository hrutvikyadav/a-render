[4846.594569, "o", "\u001b[2d\u001b[38;2;224;222;244m    protocol module (for example at a destination host) combines      \u001b[3;8H    internet datagrams that all have the same value for the four fields:\u001b[4;8H    identification, source, destination, and protocol.  The combination\u001b[5;8H    is done by placing the data portion of each fragment in the relative\u001b[6;8H    position indicated by the fragment offset in that fragment's   \u001b[7;8H    internet header.  The first fragment will have the fragment offset\u001b[8;8H    zero, and the last fragment will have the more-fragments flag reset\u001b[9;8H    to zero.                                                          \u001b[10;8H                                                                    \u001b[11;8H2.4.  Gateways\u001b[12;8H \u001b[13;8H  Gateways implement internet protocol to forward datagrams between\u001b[14;8H  networks.  Gateways also implement the Gateway to Gateway Protocol\u001b[15;8H  (GGP) [7] to coordinate routing and other internet control            \u001b[16;8H  information.                                          \u001b[17;8H \u001b[18;8H  In a gateway the higher level protocols need not be implemented and\u001b[19;3H\u001b[1m741  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  the GGP functions are added to the \u001b[38;2;25;23;36m\u001b[48;2;149;177;172mIP \u001b[38;2;224;222;244m\u001b[48;2;38;35;58mmodule.                     \u001b[20;8H\u001b[49m                                                                    \u001b[21;8H                                                              \u001b[22;8H                   +-------------------------------+            \u001b[23;8H                   | Internet Protocol & ICMP & GGP|     \u001b[24;8H                   +-------------------------------+      \u001b[25;8H                           |                 |        \u001b[26;8H                 +---------------+   +---------------+  \u001b[27;8H                 |   Local Net   |   |   Local Net   |\u001b[28;8H                 +---------------+   +---------------+\u001b[29;8H \u001b[30;8H                           Gateway Protocols \u001b[31;8H \u001b[32;8H                               Figure 3.\u001b[33;8H \u001b[34;8H \u001b[35;8H \u001b[36;8H \u001b[37;5HIP \u001b[136C                                           \u001b[8G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4846.971992, "o", "\u001b[?2026h\u001b[?25l\u001b[2 q\u001b[?25l\u001b[35m\r\n[\"protocols\"] \u001b[36m172.20.217.19 | \u001b[31m 50 | \u001b[38;2;204;204;204m \u001b[39m |                                                     \u001b[32m0:nvim*\u001b[39m                                                   \u001b[33m 0.27, 0.28, 0.29 | \u001b[34m\u001b[3m\u001b[4m12:42 03-Sep-25\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[37;8H\u001b[2 q\u001b[?12l\u001b[?25h\u001b[?2026l"]
[4847.614215, "o", "\u001b[3D\u001b[38;2;224;222;244mIP O\u001b[?25l\u001b(B\u001b[m"]
[4847.6184, "o", "\u001b[2;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   determines a local net address for the destination host.  It calls\u001b[3;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   on the local network interface for that network to send the         \u001b[4;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   datagram.                                                          \u001b[5;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                                                       \u001b[6;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   This local network interface creates a local network header and\u001b[7;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   attaches the datagram sending the result to the destination host. \u001b[8;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                                                      \u001b[9;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   At this destination host the datagram is stripped of the local net\u001b[10;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   header by the local network interface and handed to the internet\u001b[11;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   module.   \u001b[12;8H\u001b[38;2;110;106;134m│\u001b[13;8H│\u001b[38;2;224;222;244m   The internet module determines that the datagram is for an     \u001b[14;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   application program in this host.  It passes the data to the    \u001b[15;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   application program in response to a system call, passing the source\u001b[16;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m   address and other parameters as results of the call.\u001b[17;8H\u001b[38;2;110;106;134m│\u001b[18;8H│\u001b[38;2;224;222;244m                                                                    \u001b[19;3H\u001b[1m564  \u001b(B\u001b[m\u001b[38;2;110;106;134m\u001b[48;2;38;35;58m│\u001b[38;2;224;222;244m  Application                                           Application\u001b[20;8H\u001b[49m\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m  Program                                                   Program\u001b[21;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m        \\                                                   /\u001b[22;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m      Internet Module      Internet Module      Internet Module\u001b[23;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m            \\                 /       \\                /\u001b[24;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m            LNI-1          LNI-1      LNI-2         LNI-2\u001b[25;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m               \\           /             \\          /\u001b[26;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m              Local Network 1           Local Network 2\u001b[27;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                                     \u001b[28;8H\u001b[38;2;110;106;134m│\u001b[38;2;224;222;244m                                                     \u001b[29;8H\u001b[38;2;110;106;134m│\u001b[30;8H│\u001b[38;2;224;222;244m                           Transmission Path\u001b[31;8H\u001b[38;2;110;106;134m│\u001b[32;8H│\u001b[38;2;224;222;244m                               Figure 2\u001b[33;8H\u001b[38;2;110;106;134m│\u001b[34;8H│\u001b[35;8H│\u001b[36;8H│\u001b[37;5H\u001b[38;2;224;222;244mIP O\u001b[135C                                           \u001b[9G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
