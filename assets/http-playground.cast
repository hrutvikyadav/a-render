[4645.265789, "o", "\u001b[2;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\u001b[3;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[4;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[5;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[6;8H\u001b[38;2;224;222;244mInternet Engineering Task Force (IETF)                      W. Eddy, Ed.       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[7;8H\u001b[38;2;224;222;244mSTD: 7                                                       MTI Systems       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[8;8H\u001b[38;2;224;222;244mRequest for Comments: 9293                                   August 2022       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[9;8H\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mObsoletes: 793, 879, 2873, 6093, 6429, 6528,                                   \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[10;8H\u001b[49m           6691                                                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[11;8H\u001b[38;2;224;222;244mUpdates: 1011, 1122, 5961                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[12;8H\u001b[38;2;224;222;244mCategory: Standards Track                                                      \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[13;8H\u001b[38;2;224;222;244mISSN: 2070-1721                                                                \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[14;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[15;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[16;36Hon Control Protocol (TCP)                          \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[17;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[18;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[19;36H                                                   \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[20;36Hhe Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[21;36H-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[22;36Hously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[23;36His time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[49m                                                                   \u001b[14;67H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4645.266159, "o", "\u001b[H\u001b[38;2;144;140;170mrfc9293.txt                                                                                                                                                                                \u001b[14;67H\u001b[38;2;224;222;244m                    \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\u001b[15;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[16;8H\u001b[38;2;224;222;244m                  Transmission Control Protocol (TCP)                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[17;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[18;8H\u001b[38;2;224;222;244mAbstract                                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[19;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[20;8H\u001b[38;2;224;222;244m   This document specifies the Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[21;8H\u001b[38;2;224;222;244m   is an important transport-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[22;8H\u001b[38;2;224;222;244m   stack, and it has continuously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[23;8H\u001b[38;2;224;222;244m   of the Internet.  Over this time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[24;8H\u001b[38;2;224;222;244m   to TCP as it was specified in RFC 793, though these have only been          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[25;8H\u001b[38;2;224;222;244m   documented in a piecemeal fashion.  This document collects and brings       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[26;8H\u001b[38;2;224;222;244m   those changes together with the protocol specification from RFC 793.        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[27;8H\u001b[38;2;224;222;244m   This document obsoletes RFC 793, as well as RFCs 879, 2873, 6093,           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[28;8H\u001b[38;2;224;222;244m   6429, 6528, and 6691 that updated parts of RFC 793.  It updates RFCs        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[29;8H\u001b[38;2;224;222;244m   1011 and 1122, and it should be considered as a replacement for the         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[30;8H\u001b[38;2;224;222;244m   portions of those documents dealing with TCP requirements.  It also         \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[31;8H\u001b[38;2;224;222;244m   updates RFC 5961 by adding a small clarification in reset handling          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[32;8H\u001b[38;2;224;222;244m   while in the \u001b[48;2;50;54;63mSYN\u001b[49m-RECEIVED state.  The TCP header control bits from \u001b[38;2;156;207;216m/SYN     \u001b[48;2;31;29;46m \u001b[49m[1/>99]\u001b[39m\u001b[K\u001b[33;8H\u001b[38;2;224;222;244m   RFC 793 have also been updated based on RFC 3168.                           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[34;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[35;8H\u001b[38;2;224;222;244mStatus of This Memo                                                            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[36;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;2H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m                                                                                                                          \u001b[38;2;156;207;216m  ^[ │\u001b(B\u001b[m\u001b[?2026l"]
