[4940.079739, "o", "\u001b[?2026h\u001b[?25l\u001b[20;1H──────────────────────────────────────────────────────────────────────────────────────────────\u001b[32m─────────────────────────────────────────────────────────────────────────────────────────────\u001b[2 q\u001b[?25l\u001b(B\u001b[m\u001b[33m\u001b[1m\u001b[1;1Hhrutvik_\u001b(B\u001b[m in \u001b[32m\u001b[1m\u001b[2m🌐 ArbinIndia-Hrutvik\u001b(B\u001b[m in \u001b[36m\u001b[1m~/pers/protocols\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32m\u001b[4msudo\u001b(B\u001b[m \u001b[32mtcpdump\u001b[39m -i eth0 -vv -s0 -X tcp port 5001\u001b[77X\u001b[30m\u001b[43m\u001b[77C[116/620]\u001b[39m\u001b[49m\u001b[2;1H[sudo] password for hrutvik_: \u001b[16X\u001b[16C                                                                                                                                             \u001b[3;1HSorry, try again.\u001b[29X\u001b[29C                                                                                                                                             \u001b[4;1H[sudo] password for hrutvik_: \u001b[16X\u001b[16C                                                                                                                                             \u001b[5;1Htcpdump: listening on eth0, link-type EN10MB (Ethernet), snapshot length 262144 bytes\u001b[8X\u001b[8C                                                                                              \u001b[30m\u001b[43m\u001b[6;1H12:12:16.719193 IP (tos 0x0, ttl 64, id 34135, offset 0, flags [DF], proto TCP (6), length 60) \u001b[39m\u001b[49m                                                                                            \u001b[7;1H    candy_shop.com.40292 > 114.29.233.106.static.gitipl.com.5001: Flags [S], cksum 0xe0de (incorrect -> 0xf468), seq 2856349788, win 64480, options [mss 1240,sackOK,TS val 3771583369 ecr \u001b[8;1H0,nop,wscale 7], length 0                                                     