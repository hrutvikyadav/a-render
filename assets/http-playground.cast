44mDefines fields like tos, ttl, offset, id, flags, etc.                          \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[11;1H  \u001b[38;2;110;106;134m  9 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[12;1H  \u001b[38;2;110;106;134m 10 \u001b[38;2;224;222;244mTCP layer: RFC 9293                                                            \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[13;1H  \u001b[38;2;110;106;134m 11 \u001b[38;2;224;222;244m (current TCP standard, obsoletes RFC 793)                                     \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[14;1H  \u001b[38;2;110;106;134m 12 \u001b[38;2;224;222;244mDefines seq (sequence number), ack, flags (SYN/ACK/FIN/PSH/RST), window size, o\u001b[48;2;31;29;46mp\u001b[49mtions (MSS, SACK, timestamps, etc.).                                                                 \u001b[15;4H\u001b[38;2;110;106;134m13\u001b[16;4H14\u001b[17;4H15\u001b[18;4H16\u001b[19;4H17\u001b[20;4H18\u001b[21;4H19\u001b[22;5H0\u001b[23;5H1\u001b[24;5H2\u001b[25;5H3\u001b[26;4H24\u001b[27;4H25\u001b[28;4H26\u001b[29;4H27\u001b[30;4H28\u001b[31;4H29\u001b[32;4H30\u001b[33;4H31\u001b[34;4H32\u001b[35;4H33\u001b(B\u001b[m"]
