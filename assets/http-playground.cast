                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[14;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[15;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[16;8H\u001b[38;2;224;222;244m                  Transmission Control Protocol (TCP)                          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[17;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[18;8H\u001b[38;2;224;222;244mAbstract                                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[19;8H\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[20;8H\u001b[38;2;224;222;244m   This document specifies the Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[21;8H\u001b[38;2;224;222;244m   is an important transport-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[22;8H\u001b[38;2;224;222;244m   stack, and it has continuously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[23;8H\u001b[38;2;224;222;244m   of the Internet.  Over this time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[24;8H\u001b[38;2;224;222;244m   to TCP as it was specified in RFC 793, though these have only been          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[25;8H\u001b[38;2;224;222;244m   documented in a piecemeal fashion.  This document collects and brings       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[26;8H\u001b[38;2;224;222;244m   those changes together with the protocol specification from RFC 793.        \u001b[48;2;31;29;46m \u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
