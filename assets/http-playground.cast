[4176.472876, "o", "\u001b[38;2;224;222;244m \u001b[38;2;110;106;134m 27 \u001b[38;2;224;222;244mTCP Header Fields Explained (PacketLife)                                       \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[16;1H  \u001b[38;2;110;106;134m 28 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[17;1H  \u001b[38;2;110;106;134m 29 \u001b[38;2;224;222;244mEach shows you a diagram of the packet header and what fields like ttl, seq, wi\u001b[48;2;31;29;46mn\u001b[49m, mss mean.                                                                                          \u001b[18;1H  \u001b[38;2;110;106;134m 30 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[19;1H  \u001b[38;2;110;106;134m 31 \u001b[38;2;49;116;143m3. \u001b[38;2;224;222;244mBooks                                                                       \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[20;1H  \u001b[38;2;110;106;134m 32 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[21;1H  \u001b[38;2;110;106;134m 33 \u001b[38;2;224;222;244mComputer Networking: A Top-Down Approach (Kurose & Ross) →\u001b[2;4H\u001b[38;2;110;106;134m3\u001b[3;4H33\u001b[4;4H32\u001b[5;4H31\u001b[6;4H30\u001b[7;4H2\n8\u001b[9;5H7\u001b[10;5H6\u001b[11;5H5\u001b[13;5H3\u001b[14;5H2\u001b[15;5H1\u001b[16;5H0\u001b[17;4H1\u001b[18;4H18\u001b[19;4H17\u001b[20;4H16\u001b[21;4H15\u001b[59C\u001b[38;2;224;222;244m good for learning co\u001b[48;2;31;29;46mn\u001b[49mcepts like TTL and sequence numbers in context.                                                      \u001b[22;1H  \u001b[38;2;110;106;134m 14 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[23;1H  \u001b[38;2;110;106;134m 13 \u001b[38;2;224;222;244mTCP/IP Illustrated (Stevens) → deep dive into exactly what tcpdump shows you. S\u001b[48;2;31;29;46mt\u001b[49mill one of the best books for packet-level understanding.                                            \u001b[24;1H  \u001b[38;2;110;106;134m 12 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[25;1H  \u001b[38;2;110;106;134m 11 \u001b[38;2;49;116;143m4. \u001b[38;2;224;222;244mMan Pages & Tcpdump Docs                                                    \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[26;1H  \u001b[38;2;110;106;134m 10 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                \u001b(B\u001b[m"]
[4176.473569, "o", "\u001b[38;2;224;222;244m                                                                                     \u001b[27;1H  \u001b[38;2;110;106;134m  9 \u001b[38;2;224;222;244mRun:                                                                           \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[28;1H  \u001b[38;2;110;106;134m  8 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[29;1H  \u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244mman tcpdump                                                                    \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[30;1H  \u001b[38;2;110;106;134m  6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[31;1H  \u001b[38;2;110;106;134m  5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[32;1H  \u001b[38;2;110;106;134m  4 \u001b[38;2;224;222;244mScroll down to the Output Format section — it explains the keywords (tos, ttl, \u001b[48;2;31;29;46mi\u001b[49md, etc.) with short notes.                                                                           \u001b[33;1H  \u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                          