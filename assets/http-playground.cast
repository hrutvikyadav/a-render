[4176.470276, "o", "\u001b[38;2;224;222;244m             \u001b[38;2;245;193;119m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[7;1H\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m 19 \u001b[38;2;49;116;143m2. \u001b[38;2;224;222;244mPractical Field-by-Field Guides                                             \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[8;1H  \u001b[38;2;110;106;134m 20 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[9;1H  \u001b[38;2;110;106;134m 21 \u001b[38;2;224;222;244mIf RFCs feel too dense, these are great cheat sheets:                          \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[10;1H  \u001b[38;2;110;106;134m 22 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[11;1H  \u001b[38;2;110;106;134m 23 \u001b[38;2;224;222;244mIP header field explanations:                                                  \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[12;1H  \u001b[38;2;110;106;134m 24 \u001b[38;2;224;222;244mIP Header Fields Explained (PacketLife)                                        \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[13;1H  \u001b[38;2;110;106;134m 25 \u001b[38;2;224;222;244m             