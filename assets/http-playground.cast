[4622.115224, "o", "\u001b[2;1H\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[3;1H  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m                  Transmission Control Protocol (TCP)                          \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[4;1H  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[5;1H  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244mAbstract                                                                       \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[6;1H  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[7;1H  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m   This document specifies the Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[8;1H  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m   is an important transport-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[9;1H  \u001b[38;2;110;106;134m  15 \u001b[38;2;224;222;244m   stack, and it has continuously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[10;1H  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m   of the Internet.  Over this time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[11;1H  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m   to TCP as it was specified in RFC 793, though these have only been          \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[12;1H  \u001b[38;2;110;106;134m  18 \u001b[38;2;224;222;244m   documented in a piecemeal fashion.  This document collects and brings       \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[13;1H  \u001b[38;2;110;106;134m  19 \u001b[38;2;224;222;244m   those changes together with the protocol specification from RFC 793.        \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[14;1H  \u001b[38;2;110;106;134m  20 \u001b[38;2;224;222;244m   This document obsoletes RFC 793, as well as \u001b(B\u001b[m"]
[4622.11991, "o", "\u001b[2;5H\u001b[38;2;110;106;134m17\u001b[3;5H16\u001b[4;6H5\u001b[5;6H4\u001b[6;6H3\u001b[7;6H2\u001b[8;6H1\u001b[9;6H0\u001b[10;5H 9\u001b[11;5H 8\u001b[12;5H 7\u001b[13;5H 6\u001b[14;5H 5\u001b[48C\u001b[38;2;224;222;244mRFCs 879, 2873, 6093,           \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[15;1H  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m   6429, 6528, and 6691 that updated parts of RFC 793.  It updates RFCs        \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[16;1H  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244m   1011 and 1122, and it should be considered as a replacement for the         \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[17;1H  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m   portions of those documents dealing with TCP requirements.  It also         \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[18;1H  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m   updates RFC 5961 by adding a small clarification in reset handling          \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[19;1H  \u001b[1m31   \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m   while in the \u001b[38;2;25;23;36m\u001b[48;2;149;177;172mSY\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mN-RECEIVED state.  The TCP header control bits from          \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;1H\u001b[49m  \u001b[38;2;110;106;134m   1 \u001b[38;2;224;222;244m   RFC 793 have also been updated based on RFC 3168.                           \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[21;1H  \u001b[38;2;110;106;134m   2 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[22;1H  \u001b[38;2;110;106;134m   3 \u001b[38;2;224;222;244mStatus of This Memo                                                            \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[23;1H  \u001b[38;2;110;106;134m   4 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[24;1H  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m   This is an Internet Standards \u001b(B\u001b[m"]
[4622.123972, "o", "\u001b[38;2;224;222;244mTrack document.                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[25;1H  \u001b[38;2;110;106;134m   6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[26;1H  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m   This document is a product of the Internet Engineering Task Force           \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[27;1H  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m   (IETF).  It represents the consensus of the IETF community.  It has         \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[28;1H  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m   received public review and has been approved for publication by the         \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[29;1H  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m   Internet Engineering Steering Group (IESG).  Further information on         \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[30;1H  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m   Internet Standards is available in Section 2 of RFC 7841.                   \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[31;1H  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m                                           