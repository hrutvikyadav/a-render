[990.910768, "o", "\u001b[?2026h\u001b[?25l\u001b[33m\u001b[1m\u001b[21;1Hhrutvik_\u001b(B\u001b[m in \u001b[32m\u001b[1m\u001b[2m🌐 ArbinIndia-Hrutvik\u001b(B\u001b[m in \u001b[36m\u001b[1m~/pers/protocols\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mcurl\u001b[39m google.com                \u001b[K\r\n<HTML><HEAD><meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\">\u001b[K\r\n<TITLE>301 Moved</TITLE></HEAD><BODY>\u001b[K\r\n<H1>301 Moved</H1>\u001b[K\r\nThe document has moved\u001b[K\r\n<A HREF=\"http://www.google.com/\">here</A>.\u001b[K\r\n</BODY></HTML>\u001b[K\u001b[33m\u001b[1m\r\nhrutvik_\u001b(B\u001b[m in \u001b[32m\u001b[1m\u001b[2m🌐 ArbinIndia-Hrutvik\u001b(B\u001b[m in \u001b[36m\u001b[1m~/pers/protocols\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mecho\u001b[39m \u001b[33m\"we saw a tcp handshake\u001b[36m\\!\u001b[33m\"\u001b[39m\u001b[K\r\nwe saw a tcp handshake!\u001b[K\u001b[33m\u001b[1m\r\nhrutvik_\u001b(B\u001b[m in \u001b[32m\u001b[1m\u001b[2m🌐 ArbinIndia-Hrutvik\u001b(B\u001b[m in \u001b[36m\u001b[1m~/pers/protocols\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mecho\u001b[39m \u001b[33m\"there goes our request ^^\"\u001b[39m\u001b[K\r\nthere goes our request ^^\u001b[K\u001b[33m\u001b[1m\r\nhrutvik_\u001b(B\u001b[m in \u001b[32m\u001b[1m\u001b[2m🌐 ArbinIndia-Hrutvik\u001b(B\u001b[m in \u001b[36m\u001b[1m~/pers/protocols\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mecho\u001b[39m \u001b[33m\"there goes the response ^^\"\u001b[39m\u001b[K\r\nthere goes the response ^^\u001b[K\u001b[33m\u001b[1m\r\nhrutvik_\u001b(B\u001b[m in \u001b[32m\u001b[1m\u001b[2m🌐 ArbinIndia-Hrutvik\u001b(B\u001b[m in \u001b[36m\u001b[1m~/pers/protocols\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mecho\u001b[39m \u001b[33m\"connection closed from both sides\u001b[34m!\u001b[33m\"\u001b[39m\u001b[K\u001b[90m\r\n∙\u001b[39m \u001b[K\u001b[33m\u001b[1m\r\nhrutvik_\u001b(B