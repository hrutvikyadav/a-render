[4419.854431, "o", "\u001b[?2026h\u001b[21;38r\u001b[38;1H\n\u001b[A       \u001b[4m(N.B.:The\u001b(B\u001b[m \u001b[4mfollowing\u001b(B\u001b[m \u001b[4mdescription\u001b(B\u001b[m \u001b[4massumes\u001b(B\u001b[m \u001b[4mfamiliarity\u001b(B\u001b[m \u001b[4mwith\u001b(B\u001b[m \u001b[4mthe\u001b(B\u001b[m \u001b[4mTCP\u001b(B\u001b[m \u001b[4mprotocol\u001b(B\u001b[m \u001b[4mdescribed\u001b(B\u001b[m \u001b[4min\u001b(B\u001b[m \u001b[4mRFC-793.\u001b(B\u001b[m  \u001b[4mIf\u001b(B\u001b[m \u001b[4myou\u001b(B\u001b[m \u001b[4mare\u001b(B\u001b[m \u001b[4mnot\u001b(B\u001b[m \u001b[4mfamiliar\u001b(B\u001b[m \u001b[4mwith\u001b(B\u001b[m \u001b[4mthe\u001b(B\u001b[m \u001b[4mprotocol,\u001b(B\u001b[m \u001b[4mthis\u001b(B\u001b[m \u001b[4mdescription\u001b(B\u001b[m \u001b[4mwill\u001b(B\u001b[m \u001b[4mnot\u001b(B\u001b[m  \u001b[4mbe\u001b(B\u001b[m  \u001b[4mof\u001b(B\u001b[m  \u001b[4mmuch\u001b(B\u001b[m\u001b[K\r\n\u001b[7m Manual page tcpdump(8) line 480/904 58% (press h for help or q to quit)\u001b(B\u001b[m\u001b[K\u001b[1;38r\u001b[38;73H\u001b[?2026l"]
[4420.109261, "o", "\u001b[?2026h\u001b[21;38r\u001b[38;1H\n\u001b[A       \u001b[4muse\u001b(B\u001b[m \u001b[4mto\u001b(B\u001b[m \u001b[4myou.)\u001b(B\u001b[m\u001b[K\r\n\u001b[7m Manual page tcpdump(8) line 481/904 58% (press h for help or q to quit)\u001b(B\u001b[m\u001b[K\u001b[1;38r\u001b[38;73H\u001b[?2026l"]
