[4389.683296, "o", "\u001b[?2026h\u001b[21;38r\u001b[38;1H\n\u001b[A       IP identification field.  \u001b[4moffset\u001b(B\u001b[m is the fragment offset field; it is printed whether this is part of a fragmented datagram or not.  \u001b[4mflags\u001b(B\u001b[m are the MF and DF flags; \u001b[1m+ \u001b(B\u001b[mis reported if\u001b[K\r\n\u001b[7m Manual page tcpdump(8) line 467/904 56% (press h for help or q to quit)\u001b(B\u001b[m\u001b[K\u001b[1;38r\u001b[38;73H\u001b[?2026l"]
