[4844.674893, "o", "\u001b[38;2;224;222;244m-1          LN\u001b[48;2;50;54;63mI\u001b[49m-1      LN\u001b[48;2;50;54;63mI\u001b[49m-2         LN\u001b[48;2;50;54;63mI\u001b[22;6H\u001b[49m\u001b[38;2;110;106;134m3\u001b[23;6H4\u001b[24;6H5\u001b[25;6H6\u001b[26;5H 7\u001b[27;5H 8\u001b[28;5H 9\u001b[29;6H0\u001b[30;6H1\u001b[31;6H2\u001b[32;6H3\u001b[33;6H4\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 │\u001b[38;2;224;222;244m                                                                              \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[35;1H  \u001b[38;2;110;106;134m  16 │\u001b[38;2;224;222;244m                                                                              \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[36;1H  \u001b[38;2;110;106;134m  17 │\u001b[38;2;224;222;244m                                                                              \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[37;5HI\u001b[140C   \u001b[6G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4844.685702, "o", "\u001b[11;47H\u001b[38;2;224;222;244mI\u001b[19;15H\u001b[48;2;38;35;58mInternet Module      Internet Module      I\u001b[21;23H\u001b[49mI-1          LNI-1      LNI-2         LNI\u001b[37;5HI\u001b[38;2;110;106;134mTU-IHL\u001b[136C\u001b[38;2;224;222;244m \u001b[6G\u001b(B\u001b[m"]
[4844.686882, "o", "\u001b[?25l"]
[4844.689227, "o", "\u001b[11;47H\u001b[38;2;224;222;244m\u001b[48;2;50;54;63mI\u001b[19;15H\u001b[38;2;25;23;36m\u001b[48;2;149;177;172mI\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mnternet Module      \u001b[48;2;50;54;63mI\u001b[48;2;38;35;58mnternet Module      \u001b[48;2;50;54;63mI\u001b[21;23HI\u001b[49m-1          LN\u001b[48;2;50;54;63mI\u001b[49m-1      LN\u001b[48;2;50;54;63mI\u001b[49m-2         LN\u001b[48;2;50;54;63mI\u001b[37;5H\u001b[49mI\u001b[38;2;110;106;134mTU-IHL\u001b[136C\u001b[38;2;224;222;244m \u001b[6G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4844.756048, "o", "\b\u001b[38;2;224;222;244mIP\u001b[38;2;110;106;134mU-IHL\u001b[5D\u001b[?25l\u001b(B\u001b[m"]
[4844.757112, "o", "\u001b[2;8H\u001b[38;2;224;222;244m    protocol module (for example at a destination host) combines\u001b[3;8H    internet datagrams that all have the same value for the four fields:\u001b[4;8H    identification, source, destination, and protocol.  The combination\u001b[5;8H    is done by placing the data portion of each fragment in the relative\u001b[6;8H    position indicated by the fragment offset in that fragment's      \u001b[7;8H    internet header.  The first fragment will have the fragment offset\u001b[8;8H    zero, and the last fragment will have the more-fragments flag reset\u001b[9;8H    to zero.\u001b[10;8H                                                              \u001b[11;8H2.4.  Gateways                                                  \u001b[12;8H                                                                        \u001b[13;8H  Gateways implement internet protocol to forward datagrams between\u001b[14;8H  networks.  Gateways also implement the Gateway to Gateway Protocol\u001b[15;8H  (GGP) [7] to coordinate routing and other internet control\u001b[16;8H  information.                                                      \u001b[17;8H                                                                    \u001b[18;8H  In a gateway the higher level protocols need not be implemented and\u001b[19;3H\u001b[1m741  \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m  the GGP functions are added to the \u001b[38;2;25;23;36m\u001b[48;2;149;177;172mIP\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m module.                 \u001b[20;8H\u001b[49m                                                         \u001b[21;8H                                                          \u001b[22;8H                   +-------------------------------+  \u001b[23;8H                   | Internet Protocol & ICMP & GGP|    \u001b[24;8H                   +-------------------------------+\u001b[25;8H                           |                 |\u001b[26;8H                 +---------------+   +---------------+\u001b[27;8H                 |   Local Net   |   |   Local Net   |\u001b[28;8H                 +---------------+   +---------------+\u001b[29;8H                                        \u001b[30;8H                           Gateway Protocols\u001b[31;8H \u001b[32;8H                               Figure 3.\u001b[33;8H \u001b[34;8H \u001b[35;8H \u001b[36;8H \u001b[37;5HIP\u001b[38;2;110;106;134mU-IHL\u001b[132C\u001b[38;2;224;222;244m                                           \u001b[7G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4844.759916, "o", "\u001b[19;45H\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mIP\u001b[37;5H\u001b[49mIP\u001b[38;2;110;106;134ms\u001b[38;2;224;222;244m    \u001b[136C  \u001b[7G\u001b[?25l\u001b(B\u001b[m"]
[4844.760826, "o", "\u001b[19;45H\u001b[38;2;25;23;36m\u001b[48;2;149;177;172mIP\u001b[37;5H\u001b[49m\u001b[38;2;224;222;244mIP\u001b[38;2;110;106;134ms\u001b[140C\u001b[38;2;224;222;244m  \u001b[7G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4844.897898, "o", "\b\b\u001b[38;2;224;222;244mIP \u001b[38;2;110;106;134mIPs\u001b[3D\u001b[?25l\u001b(B\u001b[m"]
[4844.898523, "o", "\u001b[19;47H\u001b[38;2;25;23;36m\u001b[48;2;149;177;172m \u001b[37;5H\u001b[49m\u001b[38;2;224;222;244mIP \u001b[38;2;110;106;134mIPs\u001b[3D\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[3D\u001b[38;2;224;222;244mIP    \u001b[3D\u001b(B\u001b[m"]
[4844.8986, "o", "\u001b[?25l"]
