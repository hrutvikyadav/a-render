[4621.962036, "o", "\u001b[2;3H\u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                    \u001b[3;6H\u001b[38;2;110;106;134m4\u001b[4;6H3\u001b[5;6H2\u001b[6;6H1\u001b[7;3H\u001b[38;2;224;222;244m\u001b[1m6    \u001b(B\u001b[m\u001b[38;2;25;23;36m\u001b[48;2;149;177;172mS\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mTD: 7                                                       MTI \u001b[48;2;50;54;63mS\u001b[48;2;38;35;58mystems       \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[8;6H\u001b[49m\u001b[38;2;110;106;134m1\u001b[9;6H2\u001b[10;6H3\u001b[11;6H4\u001b[12;5H 5 \u001b[38;2;224;222;244mCategory: \u001b[48;2;50;54;63mS\u001b[13;5H\u001b[49m\u001b[38;2;110;106;134m 6 \u001b[38;2;224;222;244mI\u001b[48;2;50;54;63mSS\u001b[14;5H\u001b[49m\u001b[38;2;110;106;134m 7\u001b[15;5H 8\u001b[16;5H 9\u001b[17;6H0\u001b[18;6H1\u001b[19;6H2\u001b[20;6H3\u001b[21;6H4\u001b[22;5H15\u001b[23;5H16\u001b[24;5H17 \u001b[38;2;224;222;244m   to TCP as it was specified in RFC\u001b[25;5H\u001b[38;2;110;106;134m18\u001b[26;5H19 \u001b[38;2;224;222;244m   those changes together with the protocol specification from RFC\u001b[27;6H\u001b[38;2;110;106;134m0 \u001b[38;2;224;222;244m   This document obsoletes RFC 793, as well as RFC\u001b[28;6H\u001b[38;2;110;106;134m1 \u001b[38;2;224;222;244m   6429, 6528, and 6691 that updated parts of RFC 793.  It updates RFC\u001b[29;6H\u001b[38;2;110;106;134m2\u001b[30;6H3\u001b[31;6H4 \u001b[38;2;224;222;244m   updates RFC\u001b[32;5H\u001b[38;2;110;106;134m25 \u001b[38;2;224;222;244m   while in the \u001b[48;2;50;54;63mS\u001b[33;5H\u001b[49m\u001b[38;2;110;106;134m26 \u001b[38;2;224;222;244m   RFC 793 have also been updated based on RFC\u001b[34;5H\u001b[38;2;110;106;134m27\u001b[35;5H28 \u001b[38;2;224;222;244m\u001b[48;2;50;54;63mS\u001b[36;5H\u001b[49m\u001b[38;2;110;106;134m29\u001b[37;5H\u001b[38;2;224;222;244mS\u001b[137C     \u001b[6G\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4621.997333, "o", "\u001b[7;8H\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mSTD: 7                                                       MTI S\u001b[12;18H\u001b[49mS\u001b[13;9HSS\u001b[24;41H\u001b[48;2;50;54;63mRFC\u001b[26;71HRFC\u001b[27;35HRFC\u001b[49m 793, as well as \u001b[48;2;50;54;63mRFC\u001b[28;54HRFC\u001b[49m 793.  It updates \u001b[48;2;50;54;63mRFC\u001b[31;19HRFC\u001b[32;24H\u001b[49mS\u001b[33;11H\u001b[48;2;50;54;63mRFC\u001b[49m 793 have also been updated based on \u001b[48;2;50;54;63mRFC\u001b[35;8H\u001b[49mS\u001b[37;5HS\u001b[38;2;110;106;134mtatus\u001b[134C\u001b[38;2;224;222;244m \u001b[6G\u001b[?25l\u001b(B\u001b[m"]
