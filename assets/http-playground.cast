[4149.633866, "o", "\u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[28;1H  \u001b[38;2;110;106;134m 17 \u001b[38;2;224;222;244mTCP header fields:                                                             \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[29;1H  \u001b[38;2;110;106;134m 16 \u001b[38;2;224;222;244mTCP Header Fields Explained (PacketLife)                                       \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[30;1H  \u001b[38;2;110;106;134m 15 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[31;1H  \u001b[38;2;110;106;134m 14 \u001b[38;2;224;222;244mEach shows you a diagram of the packet header and what fields like ttl, seq, wi\u001b[48;2;31;29;46mn\u001b[49m, mss mean.                                                                                          \u001b[32;1H  \u001b[38;2;110;106;134m 13 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[33;1H  \u001b[38;2;110;106;134m 12 \u001b[38;2;49;116;143m3. \u001b[38;2;224;222;244mBooks                                                                       \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[34;1H  \u001b[38;2;110;106;134m 11 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[35;1H  \u001b[38;2;110;106;134m 10 \u001b[38;2;224;222;244mComputer Networking: A Top-Down Approach (Kurose & Ross) → good for learning co\u001b[48;2;31;29;46mn\u001b[49mcepts like TTL and sequence numbers in context.                                                      \u001b[36;1H  \u001b[38;2;110;106;134m  9 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m                                                                                                     \u001b[37;1H  \u001b[38;2;110;106;134m  8 \u001b[38;2;224;222;244mTCP/IP Illustrated (Stevens) →\u001b[2;1H\u001b[38;2;235;188;186m\u001b[58:2::128:128:128m\u001b[4m   43 \u001b[37;37H\u001b(B\u001b[m\u001b[38;2;224;222;244m deep dive into exactly what tcpdump shows you. S\u001b[48;2;31;29;46mt\u001b[49mill one of the best books for packet-level understanding.                                            \u001b[2;7H\u001b[38;2;196;167;231m\u001b[48;2;51;45;65m\u001b[58:2::128:128:128m\u001b[4m“where do these tcpdump fields come from, and how do I interpret them?”.                                                                                                             \u001b[3;1H\u001b(B\u001b[m\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  1 \u001b[38;2;224;222;244m                                                                               \u001b(B\u001b[m"]
