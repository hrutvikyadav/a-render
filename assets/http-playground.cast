[4662.058664, "o", "\u001b[3G\u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\u001b[3;5H\u001b[38;2;110;106;134m 6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \r\n\u001b[49m  \u001b[38;2;110;106;134m   5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[5;5H\u001b[49m\u001b[38;2;110;106;134m 4 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[6;5H\u001b[49m\u001b[38;2;110;106;134m 3 \u001b[38;2;224;222;244mInternet Engineering Task Force (IETF)                      W. Eddy, Ed.       \u001b[48;2;31;29;46m \u001b[7;5H\u001b[49m\u001b[38;2;110;106;134m 2 \u001b[38;2;224;222;244mSTD: 7                                                       MTI Systems       \u001b[48;2;31;29;46m \u001b[8;5H\u001b[49m\u001b[38;2;110;106;134m 1 \u001b[38;2;224;222;244mRequest for Comments: 9293                                   August 2022       \u001b[48;2;31;29;46m \u001b[9;3H\u001b[49m\u001b[1m8    \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58mObsoletes: 793, 879, 2873, 6093, 6429, 6528,                                   \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[10;5H\u001b[49m\u001b[38;2;110;106;134m 1 \u001b[38;2;224;222;244m           6691                                                                \u001b[48;2;31;29;46m \u001b[11;5H\u001b[49m\u001b[38;2;110;106;134m 2 \u001b[38;2;224;222;244mUpdates: 1011, 1122, 5961                                                      \u001b[48;2;31;29;46m \u001b[12;4H\u001b[49m\u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244mCategory: Standards Track                                                      \u001b[48;2;31;29;46m \u001b[13;4H\u001b[49m\u001b[38;2;110;106;134m  4 \u001b[38;2;224;222;244mISSN: 2070-1721                                                                \u001b[48;2;31;29;46m \u001b[14;4H\u001b[49m\u001b[38;2;110;106;134m  5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[35X\u001b[15;4H\u001b[38;2;110;106;134m  6 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[16;4H\u001b[49m\u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244m                  Transmission Control Protocol (TCP)                          \u001b[48;2;31;29;46m \u001b[17;4H\u001b[49m\u001b[38;2;110;106;134m  8 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[18;4H\u001b[49m\u001b[38;2;110;106;134m  9 \u001b[38;2;224;222;244mAbstract                                                                       \u001b[48;2;31;29;46m \u001b[19;4H\u001b[49m\u001b[38;2;110;106;134m 10 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m    \u001b[20;4H\u001b[38;2;110;106;134m 11 \u001b[38;2;224;222;244m   This document specifies the Transmission Control Protocol (TCP).  TCP       \u001b[48;2;31;29;46m \u001b[21;4H\u001b[49m\u001b[38;2;110;106;134m 12 \u001b[38;2;224;222;244m   is an important transport-layer protocol in the Internet protocol           \u001b[48;2;31;29;46m \u001b[22;4H\u001b[49m\u001b[38;2;110;106;134m 13 \u001b[38;2;224;222;244m   stack, and it has continuously evolved over decades of use and growth       \u001b[48;2;31;29;46m \u001b[23;4H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4662.059899, "o", "\u001b[38;2;110;106;134m 14 \u001b[38;2;224;222;244m   of the Internet.  Over this time, a number of changes have been made        \u001b[48;2;31;29;46m \u001b[24;4H\u001b[49m\u001b[38;2;110;106;134m 15 \u001b[38;2;224;222;244m   to TCP as it was specified in RFC 793, though these have only been          \u001b[48;2;31;29;46m \u001b[25;4H\u001b[49m\u001b[38;2;110;106;134m 16 \u001b[38;2;224;222;244m   documented in a piecemeal fashion.  This document collects and brings       \u001b[48;2;31;29;46m \u001b[26;4H\u001b[49m\u001b[38;2;110;106;134m 17 \u001b[38;2;224;222;244m   those changes together with the protocol specification from RFC 793.        \u001b[48;2;31;29;46m \u001b[27;4H\u001b[49m\u001b[38;2;110;106;134m 18 \u001b[38;2;224;222;244m   This document obsoletes RFC 793, as well as RFCs 879, 2873, 6093,           \u001b[48;2;31;29;46m \u001b[28;4H\u001b[49m\u001b[38;2;110;106;134m 19 \u001b[38;2;224;222;244m   6429, 6528, and 6691 that updated parts of RFC 793.  It updates RFCs        \u001b[48;2;31;29;46m \u001b[29;4H\u001b[49m\u001b[38;2;110;106;134m 20 \u001b[38;2;224;222;244m   1011 and 1122, and it should be considered as a replacement for the         \u001b[48;2;31;29;46m \u001b[30;4H\u001b[49m\u001b[38;2;110;106;134m 21 \u001b[38;2;224;222;244m   portions of those documents dealing with TCP requirements.  It also         \u001b[48;2;31;29;46m \u001b[31;4H\u001b[49m\u001b[38;2;110;106;134m 22 \u001b[38;2;224;222;244m   updates RFC 5961 by adding a small clarification in reset handling          \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[10X\u001b[32;4H\u001b[38;2;110;106;134m 23 \u001b[38;2;224;222;244m   while in the \u001b[48;2;50;54;63mSYN\u001b[49m-RECEIVED state.  The TCP header control bits from          \u001b[48;2;31;29;46m \u001b[33;4H\u001b[49m\u001b[38;2;110;106;134m 24 \u001b[38;2;224;222;244m   RFC 793 have also been updated based on RFC 3168.                           \u001b[48;2;31;29;46m \u001b[34;4H\u001b[49m\u001b[38;2;110;106;134m 25 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[35;4H\u001b[49m\u001b[38;2;110;106;134m 26 \u001b[38;2;224;222;244mStatus of This Memo                                                            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[46X\u001b[H\u001b[38;2;144;140;170mrfc9293.txt\u001b[36;4H\u001b[38;2;110;106;134m 27 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[37;124H\u001b[38;2;156;207;216m\u001b[48;2;46;40;51m  <20>\u001b[38;2;224;222;244m 󰦕   No KB     8,20                         263696\u001b[9;27H\u001b[?12l\u001b[?25h\u001b(B\u001b[m"]
[4662.810058, "o", "\u001b[2;3H\u001b[38;2;224;222;244m\u001b[1m1   \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m“where do these tcpdump fields come from, and how do I interpret them?”.       \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                     \u001b[3;5H\u001b[49m\u001b[38;2;110;106;134m1 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \r\n\u001b[38;2;196;167;231m   2 \u001b[38;2;224;222;244mHere’s a \u001b[58:2::196:167:231m\u001b[4:3mroadmap\u001b(B\u001b[m\u001b[38;2;224;222;244m for you:                                                      \u001b[48;2;31;29;46m \u001b[49m \u001b[5;5H\u001b[38;2;110;106;134m3 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[6;5H\u001b[38;2;110;106;134m4 \u001b[38;2;49;116;143m1. \u001b[38;2;224;222;244mThe Source: RFCs                                                            \u001b[48;2;31;29;46m \u001b[49m \u001b[7;5H\u001b[38;2;110;106;134m5 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[49m \u001b[8;5H\u001b[38;2;110;106;134m6 \u001b[38;2;224;222;244mIP layer (IPv4): RFC 791                                                       \u001b[48;2;31;29;46m \u001b[49m \u001b[9;3H\u001b[38;2;110;106;134m  7 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\u001b[10;5H\u001b[38;2;110;106;134m8 \u001b[38;2;224;222;244mDefines fields like tos, ttl, offset, id, flags, etc.                          \u001b[48;2;31;29;46m \u001b[49m \u001b[11;5H\u001b[38;2;110;106;134m9 \u001b[38;2;224;222;244m                                                               