38;2;110;106;134m  6 \u001b[38;2;224;222;244m       3.2.1.  origin-form                                                     \u001b[48;2;31;29;46m \u001b[14;4H\u001b[49m\u001b[38;2;110;106;134m  5 \u001b[38;2;224;222;244m       3.2.2.  absolute-form                                                   \u001b[48;2;31;29;46m \u001b[15;4H\u001b[49m\u001b[38;2;110;106;134m  4 \u001b[38;2;224;222;244m       3.2.3.  authority-form                                                  \u001b[48;2;31;29;46m \u001b[16;4H\u001b[49m\u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244m       3.2.4.  asterisk-form                                                   \u001b[48;2;31;29;46m \u001b[17;4H\u001b[49m\u001b[38;2;110;106;134m  2 \u001b[38;2;224;222;244m     3.3.  Reconstructing the Target URI                                       \u001b[48;2;31;29;46m \u001b[49m          \u001b[18;4H\u001b[38;2;110;106;134m  1 \u001b[38;2;224;222;244m   4.  Status Line                                                             \u001b[48;2;31;29;46m \u001b[19;3H\u001b[49m\u001b[1m85   \u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[48;2;38;35;58m   5.  Field Syntax                                                            \u001b[48;2;31;29;46m \u001b[48;2;38;35;58m                                                                                                    \u001b[20;4H\u001b[49m\u001b[38;2;110;106;134m  1 \u001b[38;2;224;222;244m     5.1.  Field Line Parsing                                                  \u001b[48;2;31;29;46m \u001b[21;4H\u001b[49m\u001b[38;2;110;106;134m  2 \u001b[38;2;224;222;244m     5.2.  Obsolete Line Folding                                               \u001b[48;2;31;29;46m \u001b[49m                                              \u001b[22;4H\u001b[38;2;110;106;134m  3 \u001b[38;2;224;222;244m   6.  Message Body                                                            \u001b[?25l\u001b(B\u001b[m"]
