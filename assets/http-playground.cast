                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   7 \u001b[38;2;224;222;244m  Internet protocol interfaces on one side to the higher level                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   8 \u001b[38;2;224;222;244m  host-to-host protocols and on the other side to the local network            \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m   9 \u001b[38;2;224;222;244m  protocol.  In this context a \"local network\" may be a small network in       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  10 \u001b[38;2;224;222;244m  a building or a large network such as the ARPANET.                           \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  11 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  12 \u001b[38;2;224;222;244m2.2.  Model of Operation                                                       \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  13 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  14 \u001b[38;2;224;222;244m  The  model of operation for transmitting a datagram from one                 \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  15 \u001b[1;38r\u001b[34;8H\u001b[?25l\u001b(B\u001b[m\u001b[?2026l"]
[4775.912765, "o", "\u001b[38;2;224;222;244m  application program to another is illustrated by the following               \u001b[48;2;31;29;46m \u001b[?2026h\u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  16 \u001b[38;2;224;222;244m  scenario:                                                                    \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\r\n\u001b[38;2;224;222;244m  \u001b[38;2;110;106;134m  17 \u001b[38;2;224;222;244m                                                                               \u001b[48;2;31;29;46m \u001b[39m\u001b[49m\u001b[K\u001b[37;146H\u001b[38;2;224;222;244m\u001b[48;2;46;40;51m96\u001b[19;8H\u001b[?12l\u001b[?25h\u001b(B\u001b[m\u001b[?2026l"]
