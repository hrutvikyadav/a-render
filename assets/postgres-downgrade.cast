[587.639503, "o", "\u001b[38;5;59m───────────────────────────────────────────────────────────────────────────────\r\u001b[39m \u001b[C\u001b[38;5;144m7627/7627 +S\u001b[38;5;59m ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[40;1H\u001b[39m\u001b[48;5;236m \u001b[49m 10109  dotnet build\r\n\u001b[48;5;236m \u001b[49m 10110  dotnet run\r\n\u001b[48;5;236m \u001b[49m 10111  ..\r\n\u001b[48;5;236m \u001b[49m 10112  dotnet run --project DAS/DAS/DAS.csproj\r\n\u001b[48;5;236m \u001b[49m 10113  echo lmao\r\n\u001b[48;5;236m \u001b[49m 10115* weekly-worklog\r\n\u001b[48;5;236m \u001b[49m 10116* weekly-timelog\r\n\u001b[48;5;236m \u001b[49m 10117* python3\r\n\u001b[48;5;236m \u001b[49m 10118  sudo systemctl status postgresql.service\r\n\u001b[48;5;236m \u001b[49m 10119  psql --version\r\n\u001b[48;5;236m \u001b[49m 10120  pgrep postgres\r\n\u001b[48;5;236m \u001b[49m 10121  ps aux | grep postgres\r\n\u001b[48;5;236m \u001b[49m 10122  ss -tulnp | grep 5432\r\n\u001b[48;5;236m \u001b[49m 10123  ss -tulnp | grep 5433\r\n\u001b[48;5;236m \u001b[49m 10124  psql -U postgres\r\n\u001b[48;5;236m \u001b[49m 10125  apt show postgresql\r\n\u001b[48;5;236m \u001b[49m 10126  which psql\r\n\u001b[48;5;236m \u001b[49m 10127* asciinema rec -i 1.5 ./postgres-downgrade.cast\r\n\u001b[48;5;236m \u001b[49m 10128* tmux a\r\n\u001b[48;5;236m \u001b[49m 10129  sudo -u postgres pg_dumpall > ~/postgres_downgrade_backup.sql\r\n\u001b[48;5;236m \u001b[49m 10130  sudo pg_lsclusters\r\n\u001b[48;5;236m \u001b[49m 10131  psql -U postgres -p5434\r\n\u001b[48;5;236m \u001b[49m 10132  psql -U hrutvik_ -p5434\r\n\u001b[38;5;161m\u001b[48;5;236m\u001b[1m>\u001b(B\u001b[m\u001b[48;5;236m \u001b[38;5;254m\u001b[1m10133  sudo -u postgres psql -p 5434\\n\u001b[228C\u001b(B\u001b[m \u001b[63;269H\u001b[3