[1149.938805, "o", "\u001b[?25l\u001b[34m\u001b[H# ----------------------------------\u001b[39m\u001b[K\u001b[34m\r\n# Put your actual configuration here\u001b[39m\u001b[K\u001b[34m\r\n# ----------------------------------\u001b[39m\u001b[K\u001b[34m\r\n#\u001b[39m\u001b[K\u001b[34m\r\n# If you want to allow non-local connections, you need to add more\u001b[39m\u001b[K\u001b[34m\r\n# \"host\" records.  In that case you will also need to make PostgreSQL\u001b[39m\u001b[K\u001b[34m\r\n# listen on a non-local interface via the listen_addresses\u001b[39m\u001b[K\u001b[34m\r\n# configuration parameter, or via the -i or -h command line switches.\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[34m\r\n# DO NOT DISABLE!\u001b[39m\u001b[K\u001b[34m\r\n# If you change this first entry you will need to make sure that the\u001b[39m\u001b[K\u001b[34m\r\n# database superuser can access the database using some other method.\u001b[39m\u001b[K\u001b[34m\r\n# Noninteractive access to all databases is required during automatic\u001b[39m\u001b[K\u001b[34m\r\n# maintenance (custom daily cronjobs, replication, and similar tasks).\u001b[39m\u001b[K\u001b[34m\r\n#\u001b[39m\u001b[K\u001b[34m\r\n# Database administrative login by Unix domain socket\u001b[39m\u001b[K\r\nlocal   all             postgres                                peer\u001b[K\r\n\u001b[K\u001b[34m\r\n# TYPE  DATABASE        USER            ADDRESS                 METHOD\u001b[39m\u001b[K\r\n\u001b[K\u001b[34m\r\n# \"local\" is for Unix domain socket connections only\u001b[39m\u001b[K\r\nlocal   all             all                                     peer\u001b[K\u001b[34m\r\n# IPv4 local connections:\u001b[39m\u001b[K\r\nhost    all             all             127.0.0.1/32            scram-sha-256\u001b[K\u001b[34m\r\n# IPv6 local connections:\u001b[39m\u001b[K\r\nhost    all             all             ::1/128                 scram-sha-256\u001b[K\u001b[34m\r\n# Allow replication connections from localhost, by a user with the\u001b[39m\u001b[K\u001b[34m\r\n# replication privilege.\u001b[39m\u001b[K\r\nlocal   replication     all                                     peer\u001b[K\r\nhost    replication     all             127.0.0.1/32            scram-sha-256\u001b[K\r\nhost    replication     all             ::1/128                 scram-sha-256\u001b[K\u001b[94m\r\n~                                                                                                                                                                                                                                                                            \u001b[36;1H~                                                                                                                                                                                                                                                                            \u001b[37;1H~                                                                                                                                                                                                                                                                            \u001b[38;1H~                                                                                                                                                                                                                                                                            \u001b[39;1H~                                                                                                                                                                                                                                                                            \u001b[40;1H~                                                                                                                                                                                                                             