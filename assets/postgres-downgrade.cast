 LISTEN 0      200         127.0.0.1:\u001b[31m\u001b[1m5433\u001b(B\u001b[m       0.0.0.0:*                                         \u001b[K\u001b[36m\u001b[1m\r\nDAS\u001b(B\u001b[m on \u001b[35m\u001b[1m alpha/1.1.0\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mpsql\u001b[39m -U postgres                                                       \u001b[140X\u001b[38;2;80;200;120m\u001b[140C  /tmp/tmux-1000/default,7127,42\u001b[39m \u001b[K\r\nWarning: No existing cluster is suitable as a default target. Please see man pg_wrapper(1) how to specify one.\u001b[K\r\npsql: error: connection to server on socket \"/var/run/postgresql/.s.PGSQL.5432\" failed: No such file or directory\u001b[K\u001b[25;8H\u001b[1K\u001b[CIs the server running locally and accepting connections on that socket?\u001b[K\u001b[36m\u001b[1m\r\nDAS\u001b(B\u001b[m on \u001b[35m\u001b[1m alpha/1.1.0\u001b(B\u001b[m \u001b[31m\u001b[1m❯\u001b(B\u001b[m \u001b[32mapt\u001b[39m show postgresql        \u001b[184X\u001b[38;2;80;200;120m\u001b[184C  /tmp/tmux-1000/default,7127,42\u001b[39m \u001b[K\r\nPackage: postgresql\u001b[K\r\nVersion: 17+274.pgdg22.04+1\u001b[K\r\nPriority: optional\u001b[K\r\nSection: database\u001b[K\r\nSource: postgresql-common (274.pgdg22.04+1)\u001b[K\r\nMaintainer: Debian PostgreSQL Maintainers <team+postgresql@tracker.debian.org>\u001b[K\r\nInstalled-Size: 80.9 kB\u001b[K\r\nProvides: postgresql-contrib (= 17)\u001b[K\r\nDepends: postgresql-17, debconf (>= 0.5) | debconf-2."]
[228.977122, "o", "0\u001b[K\r\nSuggests: postgresql-doc\u001b[K\r\nDownload-Size: 72.2 kB\u001b[K\r\nAPT-Manual-Installed: yes\u001b[K\r\nAPT-Sources: https://apt.postgresql.org/pub/repos/apt jammy-pgdg/main amd64 Packages\u001b[K\r\nDescription: object-relational SQL database (supported version)\u001b[K\r\n This metapackage always depends on the currently supported PostgreSQL\u001b[K\r\n database server version. It also offers to automatically upgrade the\u001b[K\r\n \"main\" database cluster to the lastest supported major version.\u001b[K\r\n .\u001b[K\r\n PostgreSQL is a fully featured object-relational database management\u001b[K\r\n system.  It supports a large part of the SQL standard and is designed\u001b[K\r\n to be extensible by users in many aspects.  Some of the features are:\u001b[K\r\n ACID transactions, foreign keys, views, sequences, subqueries,\u001b[K\r\n triggers, user-defined types and functions, outer joins, multiversion\u001b[K\r\n concurrency control.  Graphical user interfaces and bindings for many\u001b[K\r\n programming languages are available as well.\u001b[K\r\n\u001b[K\u001b[33m\r\nN: \u001b[39mThere is 1 additional record. Please use the '-a' switch to see it\u001b[K\u001b[36m\u001b[1m\r\nDAS\u001b(B\u001b[m on \u001b[35m\u001b[1m alpha/1.1.0\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32mwhich\u001b[39m psql            \u001b[189X\u001b[38;2;80;200;120m\u001b[189C  /tmp/tmux-1000/default,7127,42\u001b[39m \u001b[K\r\n/usr/bin/psql\u001b[K\u001b[36m\u001b[1m\r\nDAS\u001b(B\u001b[m on \u001b[35m\u001b[1m alpha/1.1.0\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m \u001b[32m\u001b[4msudo\u001b(B\u001b[m -u postgres \u001b[32mpg_dumpall\u001b[39m \u001b[33m>\u001b[39m ~/postgres_downgrade_backup.sql\u001b[150X\u001b[38;2;80;200;120m\u001b[150C  /tmp/tmux-1000/default,7127,42\u001b[39m \u001b[K\r\n[sudo] password for hrutvik_: \u001b[K\r\nSorry, try again.\u001b[K\r\n[sudo] password for hrutvik_: \u001b[K\r\nWarning: No existing cluster is suitable as a default target. Please see man pg_wrapper(1) how to specify one.\u001b[K\r\npg_dumpall: error: connection to server on socket \"/var/run/postgresql/.s.PGSQL.5432\" failed: No such file or directory\u001b[K\u001b[62;8H\u001b[1K\u001b[CIs the server running locally and accepting connections on that socket?\u001b[K\u001b[36m\u001b[1m\r\nDAS\u001b(B\u001b[m on \u001b[35m\u001b[1m alpha/1.1.0\u001b(B\u001b[m \u001b[31m\u001b[1m❯\u001b(B\u001b[m \u001b[32m\u001b[4msudo\u001b(B\u001b[m -u postgres \u001b[32mpg_upgradecluster\u001b[39m\u001b[1m \u001b(B\u001b[m\u001b[168X\u001b[38;2;80;200;120m\u001b[168C  /tmp/tmux-1000/default,7127,42\u001b[39m took \u001b[33m\u001b[1m9s\u001b(B\u001b[m \u001b[K\u001b[34m\u001b[1m\r\nArbinLibrary\u001b(B\u001b[m/                   \u001b[34m\u001b[1mConnectToPostgresql\u001b(B\u001b[m/            \u001b[34m\u001b[1mDAS\u001b(B\u001b[m/                            \u001b[34m\u001b[1mFirmwareMitsX\u001b(B\u001b[m/                  \u001b[34m\u001b[1mMisc\u001b(B\u001b[m/                           \u001b[34m\u001b[1mScripts\u001b(B\u001b[m/                        \u001b[34m\u001b[1mWebConsole\u001b(B\u001b[m/                     remove_bin_obj.bat            \u001b[K\u001b[34m\u001b[1m\r\nBuildDLL\u001b(B\u001b[m/                       \u001b[34m\u001b[1mConsole\u001b(B\u001b[m/                        \u001b[34m\u001b[1mEOL\u001b(B\u001b[m/                            \u001b[34m\u001b[1mHelp\u001b(B\u001b[m/                           README.md                       SoftwareAssetDependencies.json  \u001b[34m\u001b[1mazure-script\u001b(B\u001b[m/                                                 \u001b[K\u001b[?12l\u001b[?25h\u001b[63;59H\u001b[?2004h"]
