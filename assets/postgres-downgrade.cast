[1002.435606, "o", "\u001b[1;65r\u001b[1;1H\u001b[2;65r\u001b[64S\u001b[1;1H\u001b[K\u001b[34m# its special character, and just match a database or username with\r\n# that name.\r\n#\r\n# ---------------\r\n# Include Records\r\n# ---------------\r\n#\r\n# This file allows the inclusion of external files or directories holding\r\n# more records, using the following keywords:\r\n#\r\n# include           FILE\r\n# include_if_exists FILE\r\n# include_dir       DIRECTORY\r\n#\r\n# FILE is the file name to include, and DIR is the directory name containing\r\n# the file(s) to include.  Any file in a directory will be loaded if suffixed\r\n# with \".conf\".  The files of a directory are ordered by name.\r\n# include_if_exists ignores missing files.  FILE and DIRECTORY can be\r\n# specified as a relative or an absolute path, and can be double-quoted if\r\n# they contain spaces.\r\n#\r\n# -------------\r\n# Miscellaneous\r\n# -------------\r\n#\r\n# This file is read on server startup and when the server receives a\r\n# SIGHUP signal.  If you edit the file on a running system, you have to\r\n# SIGHUP the server for the changes to take effect, run \"pg_ctl reload\",\r\n# or execute \"SELECT pg_reload_conf()\".\r\n#\r\n# ----------------------------------\r\n# Put your actual configuration here\r\n# ----------------------------------\r\n#\r\n# If you want to allow non-local connections, you need to add more\r\n# \"host\" records.  In that case you will also need to make PostgreSQL\r\n# listen on a non-local interface via the listen_addresses\r\n# configuration parameter, or via the -i or -h command line switches.\u001b[43;1H# DO NOT DISABLE!\r\n# If you change this first entry you will need to make sure that the\r\n# database superuser can access the database using some other method.\r\n# Noninteractive access to all databases is required during automatic\r\n# maintenance (custom daily cronjobs, replication, and similar tasks).\r\n#\r\n# Database administrative login by Unix domain socket\r\n\u001b[39mlocal   all\u001b[13Cpostgres\u001b[32Cpeer\u001b[52;1H\u001b[34m# TYPE  DATABASE        USER            ADDRESS                 METHOD\u001b[54;1H# \"local\" is for Unix domain socket connections only\u001b[1;66r\u001b[54;53H\u001b(B\u001b[m"]
[1002.435806, "o", "\r\nlocal   all\u001b[13Call\u001b[37Cpeer\r\n\u001b[34m# IPv4 local connections:\r\n\u001b[39mhost    all\u001b[13Call\u001b[13C127.0.0.1/32\u001b[12Cscram-sha-256\r\n\u001b[34m# IPv6 local connections:\r\n\u001b[39mhost    all\u001b[13Call\u001b[13C::1/128\u001b[17Cscram-sha-256\r\n\u001b[34m# Allow replication connections from localhost, by a user with the\r\n# replication privilege.\r\n\u001b[39mlocal   replication     all\u001b[37Cpeer\r\nhost    replication     all\u001b[13C127.0.0.1/32\u001b[12Cscram-sha-256\r\nhost    replication     all\u001b[13C::1/128\u001b[17Cscram-sha-256\u001b[65;252H118,65\u001b[8CBot\u001b[50;65H\u001b[?12l\u001b[?25h"]
[1004.868509, "o", "\u001b[65;242Hz\u001b[50;65H"]
[1004.997285, "o", "\u001b[65;243Hz\u001b[50;65H\u001b[?25l"]
