[7461.70751, "o", "\u001b[?2026h\r\n\u001b[32m──────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m─────────────────────────────────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[1;1H an optional 0..8 value as RTR frames can contain a valid dlc field\u001b[K\r\n_{dlc}:\u001b[K\r\n an optional 9..F data length code value when payload length is 8\u001b[K\r\n<flags>:\u001b[K\r\n a single ASCII Hex value (0 .. F) which defines canfd_frame.flags\u001b[K\r\n\u001b[K\r\nExamples:\u001b[K\r\n  5A1#11.2233.44556677.88 / 123#DEADBEEF / 5AA# / 123##1 / 213##311223344 /\u001b[K\r\n  1F334455#1122334455667788_B / 123#R / 00000123#R3 / 333#R8_E\u001b[K\r\n\u001b[K\r\nubuntu@primary:~$ cansend vcan0 100#11223344\u001b[K\r\nubuntu@primary:~$ cansend vcan0 456#DEADBEEF\u001b[K\r\nubuntu@primary:~$ cansend vcan0 100#11223344\u001b[K\r\nubuntu@primary:~$ # we sent basic heartbeat frames and captured them in below window!\u001b[K\r\nubuntu@primary:~$ cangen van0\u001b[K\r\nSIOCGIFINDEX: No such device\u001b[K\r\nubuntu@primary:~$ cangen vcan0\u001b[K\r\n^Cubuntu@primary:~$ man cangen \u001b[K\r\nubuntu@primary:~$ \u001b[K\u001b[21;1H  vcan0  TX - -  4BB   [8]  B8 4B 87 09 B4 38 B9 42\u001b[K\r\n  vcan0  TX - -  507   [0] \u001b[K\r\n  vcan0  TX - -  565   [5]  BB 9D 3F 56 52\u001b[K\r\n  vcan0  TX - -  485   [8]  87 31 47 11 97 CC 70 5B\u001b[K\r\n  vcan0  TX - -  633   [1]  4E\u001b[K\r\n  vcan0  TX - -  5CB   [4]  36 A9 02 2E\u001b[K\r\n  vcan0  TX - -  2E4   [8]  8A 64 50 11 4A 1B 9D 32\u001b[K\r\n  vcan0  TX - -  7E5   [8]  8F 52 3D 5C A0 A4 BA 1B\u001b[K\r\n  vcan0  TX - -  1B5   [7]  55 DD 73 5E BC 2E 79\u001b[K\r\n  vcan0  TX - -  7A8   [8]  BF 08 12 05 0D 8D 85 2B\u001b[K\r\n  vcan0  TX - -  3BF   [8]  5F 2E 7F 71 45 D0 5D 1A\u001b[K\r\n  vcan0  TX - -  329   [7]  DC 9C CE 75 5C 49 BC\u001b[K\r\n  vcan0  TX - -  4B8   [8]  5D B3 4B 44 84 9A 9D 46\u001b[K\r\n  vcan0  TX - -  4AF   [3]  B5 0F F