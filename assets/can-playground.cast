[1939.949457, "o", "\u001b[?2026h\u001b[1;19r\u001b[1;1H\u001b[5S\u001b[14dcansend - send CAN-frames via CAN_RAW sockets.\r\n\u001b[K\r\nUsage: cansend <device> <can_frame>.\u001b[K\r\n\u001b[K\r\n<can_frame>:\u001b[K\r\n\u001b[K\u001b[1;38r\u001b[19;1H\u001b[?2026l"]
[1939.95041, "o", "\u001b[?2026h\u001b[1;19r\u001b[1;1H\u001b[3S\u001b[16d <can_id>#{data}          for Classical CAN 2.0 data frames\r\n <can_id>#R{len}          for Classical CAN 2.0 data frames\u001b[K\r\n <can_id>#{data}_{dlc}    for Classical CAN 2.0 data frames\u001b[K\r\n\u001b[K\u001b[1;38r\u001b[19;1H\u001b[?2026l"]
[1939.951404, "o", "\u001b[?2026h\u001b[1;19r\u001b[1;1H\u001b[18S <can_id>#R{len}_{dlc}    for Classical CAN 2.0 data frames\r\n <can_id>##<flags>{data}  for CAN FD frames\u001b[K\r\n\u001b[K\r\n<can_id>:\u001b[K\r\n 3 (SFF) or 8 (EFF) hex chars\u001b[K\r\n{data}:\u001b[K\r\n 0..8 (0..64 CAN FD) ASCII hex-values (optionally separated by '.')\u001b[K\r\n{len}:\u001b[K\r\n an optional 0..8 value as RTR frames can contain a valid dlc field\u001b[K\r\n_{dlc}:\u001b[K\r\n an optional 9..F data length code value when payload length is 8\u001b[K\r\n<flags>:\u001b[K\r\n a single ASCII Hex value (0 .. F) which defines canfd_frame.flags\u001b[K\r\n\u001b[K\r\nExamples:\u001b[K\r\n  5A1#11.2233.44556677.88 / 123#DEADBEEF / 5AA# / 123##1 / 213##311223344 /\u001b[K\r\n  1F334455#1122334455667788_B / 123#R / 00000123#R3 / 333#R8_E\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[1;38r\u001b[19;1H\u001b[?2026l"]
[1939.9516, "o", "ubuntu@primary:~$ \u001b[?2004h"]
[1942.435042, "o", "\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[1942.6262, "o", "\u001b[?2026h\u001b[?25l\u001b[Hbuiltin-check      exec-cmd           help               librbtree          nlattr             parser.tab         ringbuf            subcmd-config      zip\u001b[K\r\ncheck              expr               lex.lex            libstring          objtool            preprocess         run-command        sumversion         \u001b[K\r\nconf               file2alias         lexer.lex          libsubcmd-in       objtool-in         rbtree             sigchain           symbol             \u001b[K\r\nconfdata           fixdep             libbpf             linker             orc_dump           relo_core          special            symsearch          \u001b[K\r\nubuntu@primary:~$ sudo modprobe vcan\u001b[K\r\nubuntu@primary:~$ sudo ip link add dev vcan0 type vcan\u001b[K\r\nubuntu@primary:~$ sudo ip link set up vcan0\u001b[K\r\nubuntu@primary:~$ ip link show vcan0\u001b[K\r\n4: vcan0: <NOARP,UP,LOWER_UP> mtu 72 qdisc noqueue state UNKNOWN mode DEFAULT group default qlen 1000\u001b[K\r\n    link/can \u001b[K\r\nubuntu@primary:~$ cansend --help\u001b[K\r\ncansend - send CAN-frames via CAN_RAW sockets.\u001b[K\r\n\u001b[K\r\nUsage: cansend <device> <can_frame>.\u001b[K\r\n\u001b[K\r\n<can_frame>:\u001b[K\r\n <can_id>#{data}          for Classical CAN 2.0 data frames\u001b[K\r\n <can_id>#R{len}          for Classical CAN 2.0 data frames\u001b[K\r\n <can_id>#{data}_{dlc}    for Classical CAN 2.0 data frames\u001b[K\r\n <can_id>#R{len}_{dlc}    for Classical CAN 2.0 data frames\u001b[K\r\n <can_id>##<flags>{data}  for CAN FD frames\u001b[K\r\n\u001b[K\r\n<can_id>:\u001b[K\r\n 3 (SFF) or 8 (EFF) hex chars\u001b[K\r\n{data}:\u001b[K\r\n 0..8 (0..64 CAN FD) ASCII hex-values (optionally separated by '.')\u001b[K\r\n{len}:\u001b[K\r\n an optional 0..8 value as RTR frames can contain a valid dlc field\u001b[K\r\n_{dlc}:\u001b[K\r\n an optional 9..F data length code value when payload length is 8\u001b[K\r\n<flags>:\u001b[K\r\n a single ASCII Hex value (0 .. F) which defines canfd_frame.flags\u001b[K\r\n\u001b[K\r\nExamples:\u001b[K\r\n  5A1#11.2233.44556677.88 / 123#DEADBEEF / 5AA# / 123##1 / 213##311223344 /\u001b[K\r\n  1F334455#1122334455667788_B / 123#R / 00000123#R3 / 333#R8_E\u001b[K\r\n\u001b[K\r\nubuntu@primary:~$ \u001b[K\u001b[?12l\u001b[?25h\u001b[?2026l"]
