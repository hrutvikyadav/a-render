[156.893001, "o", "\u001b[48;2;25;23;36m                                                                                                                                                                                           \u001b[25;1H                                                                                                                                                                                           \u001b[26;1H                                                                                                                                                                                           \u001b[27;1H                                                                                                                                                                                           \u001b[28;1H                                                                                                                                                                                           \u001b[29;1H                                                                                                                                                                                           \u001b[30;1H                                                                                                                                                                                           \u001b[31;1H                                                                                                                                                                                           \u001b[32;1H                                                                                                                                                                                           \u001b[33;1H                                                                                                                                                                                           \u001b[34;1H                                                                                                                                                                                           \u001b[35;1H                                                                                                                                                                                           \u001b[36;1H                                                                                                                                                                                           \u001b[37;1H                                                                                                                                                                                           \u001b[38;1H\u001b[38;2;144;140;170m\u001b[1m>\u001b(B\u001b[m\u001b[38;2;144;140;170m\u001b[48;2;25;23;36m \u001b[39m                                                                                                                                                                                         \u001b[37;1H\u001b[38;2;246;193;119m\u001b[1m⠏\u001b[C\u001b(B\u001b[m\u001b[38;2;156;207;216m\u001b[48;2;25;23;36m0/1481 +S\u001b[38;2;64;61;82m ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[?25l\u001b(B\u001b[m"]
[156.898028, "o", "\u001b[38;2;64;61;82m\u001b[48;2;25;23;36m────────────────────────────────────────\r\u001b[38;2;246;193;119m\u001b[1m⠏\u001b[C\u001b(B\u001b[m\u001b[38;2;156;207;216m\u001b[48;2;25;23;36m0/1481 +S\u001b[38;2;64;61;82m ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[38;2;246;193;119m\u001b[1m⠏\u001b[C\u001b(B\u001b[m\u001b[38;2;156;207;216m\u001b[48;2;25;23;36m1481/7026 +S\u001b[38;2;64;61;82m ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[24;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10003  cp ~/http-playground.cast .\r\n \u001b[39m \u001b[38;2;144;140;170m10004  apt show can-utils\r\n \u001b[39m \u001b[38;2;144;140;170m10005  sudo apt install can-utils\r\n \u001b[39m \u001b[38;2;144;140;170m10006  man candump\r\n \u001b[39m \u001b[38;2;144;140;170m10008  -\r\n \u001b[39m \u001b[38;2;144;140;170m10009* asciinema rec -i 1.5 can-playground.cast\r\n \u001b[39m \u001b[38;2;144;140;170m10010* tmux a\r\n \u001b[39m \u001b[38;2;144;140;170m10011  # SIMPLE CAN LAB\r\n \u001b[39m \u001b[38;2;144;140;170m10012  #1 Lets setup a virtual CAN interface\r\n \u001b[39m \u001b[38;2;144;140;170m10013  sudo modprobe vcan\r\n \u001b[39m \u001b[38;2;144;140;170m10014  # OK it seeems missing in wsl\r\n \u001b[39m \u001b[38;2;144;140;170m10015  # Lets try multiplass\r\n\u001b[38;2;196;167;231m\u001b[48;2;38;35;58m\u001b[1m>\u001b(B\u001b[m\u001b[38;2;144;140;170m\u001b[48;2;38;35;58m \u001b[38;2;224;222;244m\u001b[1m10016  cmd.exe\u001b[170C\u001b(B\u001b[m\u001b[48;2;25;23;36m \u001b[36;187H\u001b[38;2;64;61;82m│\u001b[?2026h\u001b[39m\u001b[49m\u001b[25;1H\u001b[J\u001b[A\u001b[K\u001b[48;2;25;23;36m                                                                                          