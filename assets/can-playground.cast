[156.911889, "o", "\u001b[24;1H\u001b[38;2;144;140;170m\u001b[48;2;25;23;36m \u001b[39m \u001b[38;2;144;140;170m10003  cp ~/http-playground.cast .\r\n \u001b[39m \u001b[38;2;144;140;170m10004  apt show can-utils\r\n \u001b[39m \u001b[38;2;144;140;170m10005  sudo apt install can-utils\r\n \u001b[39m \u001b[38;2;144;140;170m10006  man candump\u001b[121C\u001b[39m                                              \u001b[28;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10008  -\u001b[39m                                                                                                                                                                                 \u001b[29;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10009* asciinema rec -i 1.5 can-playground.cast\u001b[39m                                                                                                                                          \u001b[30;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10010* tmux a\u001b[39m                                                                                                                                                                            \u001b[31;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10011  # SIMPLE CAN LAB\u001b[39m                                                                                                                                                                  \u001b[32;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10012  #1 Lets setup a virtual CAN interface\u001b[39m                                                                                                                                             \u001b[33;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10013  sudo modprobe vcan\u001b[39m                                                                                                                                                                \u001b[34;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10014  # OK it seeems missing in wsl\u001b[39m                                                                                                                                                     \u001b[35;1H\u001b[38;2;144;140;170m \u001b[39m \u001b[38;2;144;140;170m10015  # Lets try multiplass\u001b[39m                                                                                                                                                             \u001b[36;1H\u001b[38;2;196;167;231m\u001b[48;2;38;35;58m\u001b[1m>\u001b(B\u001b[m\u001b[38;2;144;140;170m\u001b[48;2;38;35;58m \u001b[38;2;224;222;244m\u001b[1m10016  cmd.exe\u001b(B\u001b[m\u001b[48;2;25;23;36m                                                                                                                                                                           \u001b[37;1H                                                                                                                                                                                           \u001b[38;1H                                                                                                                                                                                           \u001b[36;187H\u001b(B\u001b[m"]
