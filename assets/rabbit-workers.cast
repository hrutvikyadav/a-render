[1279.658371, "o", "\u001b[38;2;224;222;244m\u001b[3mlogFile\u001b(B\u001b[m\u001b[38;2;144;140;170m,\u001b[38;2;224;222;244m \u001b[3merr\u001b(B\u001b[m\u001b[38;2;224;222;244m \u001b[38;2;144;140;170m:=\u001b[38;2;224;222;244m \u001b[3mos\u001b(B\u001b[m\u001b[38;2;144;140;170m.\u001b[38;2;196;167;231m\u001b[3mOpenFile\u001b(B\u001b[m\u001b[38;2;115;102;153m\u001b[1m\u001b[4m(\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[3mlogFileName\u001b(B\u001b[m\u001b[38;2;144;140;170m,\u001b[38;2;224;222;244m \u001b[3mos\u001b(B\u001b[m\u001b[38;2;144;140;170m.\u001b[38;2;156;207;216m\u001b[3mO_APPEND\u001b(B\u001b[m\u001b[38;2;144;140;170m|\u001b[38;2;224;222;244m\u001b[3mos\u001b(B\u001b[m\u001b[38;2;144;140;170m.\u001b[38;2;156;207;216m\u001b[3mO_CREATE\u001b(B\u001b[m\u001b[38;2;144;140;170m|\u001b[38;2;224;222;244m\u001b[3mos\u001b(B\u001b[m\u001b[38;2;144;140;170m.\u001b[38;2;156;207;216m\u001b[3mO_WRONL\u001b[48;2;31;29;46mY\u001b(B\u001b[m\u001b[38;2;144;140;170m,\u001b[38;2;224;222;244m \u001b[38;2;246;193;119m0644\u001b[38;2;115;102;153m\u001b[1m\u001b[4m)\u001b[47;5H\u001b(B\u001b[m\u001b[38;2;110;106;134m5 <-->\u001b[38;2;235;188;186m\u001b[3mfailOnError\u001b(B\u001b[m\u001b[38;2;115;102;153m\u001b[1m\u001b[4m(\u001b(B\u001b[m\u001b[38;2;224;222;244m\u001b[3merr\u001b(B\u001b[m\u001b[38;2;144;140;170m,\u001b[38;2;224;222;244m \u001b[38;2;246;193;119m\"Failed to open log file\"\u001b[38;2;115;102;153m\u001b[1m\u001b[4m)\u001b[48;5H\u001b(B\u001b[m\u001b[38;2;110;106;134m6 <-->\u001b[38;2;49;116;143mdefer\u001b[38;2;224;222;244m \u001b[3mlogFile\u001b(B\u001b[m\u001b[38;2;144;140;170m.\u001b[38;2;196;167;231m\u001b[3mClose\u001b(B\u001b[m\u001b[38;2;115;102;153m\u001b[1m\u001b[4m()\u001b[49;5H\u001b(B\u001b[m\u001b[38;2;110;106;134m7 \u001b[38;2;224;222;244m                                     \u001b[50;5H\u001b[38;2;110;106;134m8 <-->\u001b[38;2;144;140;170m\u001b[3m// set log output to the log file\u001b[51;4H\u001b(B\u001b[m\u001b[38;2;110;106;134m29 <-->\u00